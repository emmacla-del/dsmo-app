// ─── AXIS 2 : RELATIONAL DATA QUALITY REGISTRY ──────────────────────────────

enum AnomalyStatus {
  OPEN
  RESOLVED
  WAIVED
}

enum AnomalySeverity {
  CRITICAL
  WARNING
}

enum AnomalyResolutionType {
  DECLARANT_CORRECTION
  FIELD_INSPECTION
  LEGAL_DEROGATION
}

model OnefopAnomaly {
  id              String                 @id @default(uuid())
  submissionId    String
  ruleCode        String
  ruleFamily      String
  severity        AnomalySeverity        @default(CRITICAL)
  isBlocking      Boolean                @default(true)
  status          AnomalyStatus          @default(OPEN)
  description     String
  observedValue   String
  expectedValue   String
  deltaValue      String?
  detectedAt      DateTime               @default(now())
  resolvedAt      DateTime?
  resolvedById    String?
  resolutionType  AnomalyResolutionType?
  resolutionNote  String?
  evidenceUrl     String?
  submission      OnefopSubmission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  resolvedBy      User?                  @relation("AnomalyResolver", fields: [resolvedById], references: [id])

  @@index([submissionId])
  @@index([status, isBlocking])
  @@index([ruleCode])
  @@map("onefop_anomalies")
}

// ─── STATISTICAL GATE : CAMPAIGN FREEZE SNAPSHOT ────────────────────────────

model CampaignFreeze {
  id              String       @id @default(uuid())
  campaignId      String
  versionTag      String
  frozenAt        DateTime     @default(now())
  frozenById      String
  totalTargeted   Int          @default(0)
  totalSubmitted  Int          @default(0)
  totalIncluded   Int          @default(0)
  totalExcluded   Int          @default(0)
  sha256Digest    String
  metadata        Json?
  campaign        DataCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  frozenBy        User         @relation("CampaignFrozenBy", fields: [frozenById], references: [id])

  @@unique([campaignId, versionTag])
  @@index([campaignId])
  @@map("campaign_freezes")
}

// Territorial inscription targets and campaign quotas.
//
// departmentId is null on a region-level row. PostgreSQL unique constraints
// treat those NULLs as distinct, so a plain @@unique([year, regionId,
// departmentId]) would allow two region-level rows for the same year.
// Uniqueness is two partial indexes in the migration SQL, same approach as
// onefop_submissions_company_quarter_live_uidx. Do not add @@unique for
// this key: Prisma cannot express the WHERE clause and would generate a
// different constraint. Non-negative checks are SQL CHECKs for the same reason.
//
// "Niveau central" is not a Region and not a null regionId. Administrations
// use CentralInscriptionTarget / CentralCampaignQuota.

// DEPRECATED 2026-10-05. Registration targets are now CampaignQuota rows
// attached to a synthetic annual campaign. Kept for migration rollback;
// do not write.
model TerritoryTarget {
  id                String      @id @default(uuid())
  year              Int
  regionId          String
  departmentId      String?
  inscriptionTarget Int
  createdBy         String
  updatedBy         String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  region            Region      @relation(fields: [regionId], references: [id], onDelete: Restrict)
  department        Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdByUser     User        @relation("TerritoryTargetCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser     User        @relation("TerritoryTargetUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([year])
  @@index([regionId])
  @@index([departmentId])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("territory_targets")
}

// The unified quota table. A row is either TERRITORIAL — one per region,
// or one per department — or the single ADMINISTRATION row for the campaign,
// which holds the target for the ministry cohort and carries no region or
// department at all. Cohort is the permanent granularity for ADMINISTRATION:
// per-ministry targets, should they ever arrive, would be a new scopeKind
// value, not a nullable ministry column.
//
// Four invariants below are hand-written SQL in
// 20261008120000_campaign_quota_scope_kind, not Prisma attributes, because
// Prisma can express neither WHERE on @@unique nor CHECK constraints:
//
//   - one ADMINISTRATION row per campaign
//   - one TERRITORIAL region-level row per (campaign, region)
//   - one TERRITORIAL department row per (campaign, region, department)
//   - the scope shape: ADMINISTRATION => regionId and departmentId both NULL;
//     TERRITORIAL => regionId NOT NULL
//
// regionId is nullable only to admit the ADMINISTRATION row. Every reader
// that treats it as non-null must first narrow on scopeKind.
model CampaignQuota {
  id               String             @id @default(uuid())
  campaignId       String
  scopeKind        CampaignQuotaScope @default(TERRITORIAL)
  regionId         String?
  departmentId     String?
  submissionTarget Int
  createdBy        String
  updatedBy        String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  campaign         DataCampaign       @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  region           Region?            @relation(fields: [regionId], references: [id], onDelete: Restrict)
  department       Department?        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdByUser    User               @relation("CampaignQuotaCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser    User               @relation("CampaignQuotaUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([regionId])
  @@index([departmentId])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("campaign_quotas")
}

// DEPRECATED 2026-10-05. National registration targets are now the sum of
// CampaignQuota rows. Kept for migration rollback; do not write.
model CentralInscriptionTarget {
  id                String   @id @default(uuid())
  year              Int      @unique
  inscriptionTarget Int
  createdBy         String
  updatedBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdByUser     User     @relation("CentralInscriptionTargetCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser     User     @relation("CentralInscriptionTargetUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([createdBy])
  @@index([updatedBy])
  @@map("central_inscription_targets")
}

// DEPRECATED 2026-10-05. National totals are now computed as the sum of
// CampaignQuota rows. Kept for migration rollback; do not write.
model CentralCampaignQuota {
  id               String       @id @default(uuid())
  campaignId       String       @unique
  submissionTarget Int
  createdBy        String
  updatedBy        String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  campaign         DataCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  createdByUser    User         @relation("CentralCampaignQuotaCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser    User         @relation("CentralCampaignQuotaUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([createdBy])
  @@index([updatedBy])
  @@map("central_campaign_quotas")
}

