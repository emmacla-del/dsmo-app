// Phase 1 — Projects & Programs Section 1 identification (PP_S1Q01-16)
// + Section 3's outcomes/perspectives KPI grid, embedded directly as 12
// nullable scalar columns rather than a child table — it's a small
// fixed 4-row x 3-period shape (see kpi_period_table in
// table_spec_builder.dart), unlike Section 2's genuinely variable-count
// activities (see ProjectProgramActivity below).
model OnefopProjectProgramDetail {
  id                       String           @id @default(uuid())
  submissionId             String           @unique
  nature                   String
  name                     String
  sigle                    String?
