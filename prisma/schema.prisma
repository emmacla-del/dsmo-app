// 4.3, 4.4, 4.5, 4.6, 4.10, 6.3, 8.4, 8.7 — repeating respondent rows, one
// specialty/filière per row. Named nullable columns, not generic cellN —
// tableCode decides which are filled, unused columns stay null:
//   4.3, 4.4, 4.5, 8.4 -> fiMale/fiFemale/fcMale/fcFemale
//   4.6                -> year1Male/year1Female/year2Male/year2Female
//   4.10, 6.3           -> male/female/total
//   8.7 (page 17, FI/FC only, no gender split, no printed Total row)
//                       -> fiCount/fcCount
model OnefopVtSpecialtyRow {
  id            String   @id @default(uuid())
  submissionId  String
  tableCode     String
  rowIndex      Int
