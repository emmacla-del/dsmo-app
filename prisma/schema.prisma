  @@unique([establishmentId, quarterCode])
  @@index([establishmentId])
  @@map("submission_drafts")
}

// Partial unique index (raw SQL, not expressible in this DSL — Prisma
// doesn't support a WHERE predicate on @@unique/@@index):
//   CREATE UNIQUE INDEX "onefop_submissions_company_quarter_live_uidx"
//     ON "onefop_submissions" ("companyId", "quarterCode")
//     WHERE "status" IN ('PENDING_REVIEW', 'APPROVED');
// See prisma/migrations/20260909100000_add_onefop_submission_duplicate_guard.
// Deliberately NOT mirrored below as an @@index/@@unique: a plain
// (companyId, quarterCode) directive here has no WHERE clause, so
// `prisma migrate dev`/`diff` would treat it as a *different*, stricter
// constraint than the one this migration actually created — generating a
// migration that tries to add a full-table unique index on top, which
// fails outright (DRAFT/REJECTED/CORRECTION_REQUESTED rows already repeat
// (companyId, quarterCode) by design) or, if it somehow applied, would
// silently block legitimate multiple drafts/rejections per quarter. If
// this model is ever introspected (`prisma db pull`), check the diff
// before accepting it — introspection may not round-trip the WHERE
// clause correctly, and this comment is the only place that clause is
// recorded. Do not add a matching @@unique/@@index here.
model OnefopSubmission {
  id                    String                        @id @default(uuid())
  submissionId          String                        @unique @default(uuid())
  formType              OnefopEntityType
  status                OnefopStatus                  @default(PENDING_REVIEW)
  rawData               Json
  flags                 Json?
  rejectionReason       String?
  reviewedBy            String?
  reviewedAt            DateTime?
  pdfUrl                String?
  surveyYear            Int
  submissionDate        DateTime                      @default(now())
  region                String?
  department            String?
  subdivision           String?
  submittedBy           String?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  companyId             String?
  regionId              String?
  departmentId          String?
  subdivisionId         String?
  establishmentId       String
  quarterCode           String?                       @default("2025-T1")
  taxNumber             String?
  cnpsNumber            String?
  // Campaign this submission was filed under (campaign progress, phase B1).
  // Nullable: pre-existing rows and submissions filed outside a campaign
  // have none. Nothing writes it yet.
  campaignId            String?
  isLate                Boolean                       @default(false)
  effectiveDeadlineSnapshot DateTime?
  registrationNumber    String?
  metaJson              Json?
  administrationDetail  OnefopAdministrationDetail?
  projectProgramDetail  OnefopProjectProgramDetail?
  projectProgramActivities ProjectProgramActivity[]
  vocationalTrainingDetail OnefopVocationalTrainingDetail?
  vtDiplomaData         OnefopVtDiplomaData[]
  vtTraineeAgeFlow      OnefopVtTraineeAgeFlow[]
  vtTrainerAge          OnefopVtTrainerAge[]
  vtEducationLevelFlow  OnefopVtEducationLevelFlow[]
  vtTraineeVulnerable   OnefopVtTraineeVulnerable[]
  vtTrainerDisability   OnefopVtTrainerDisability[]
  vtScholarship         OnefopVtScholarship[]
  vtSpecialtyRows       OnefopVtSpecialtyRow[]
  vtCurricula           OnefopVtCurriculum[]
  vtInfrastructure      OnefopVtInfrastructure[]
  vtFurniture           OnefopVtFurniture[]
  vtTrainerRoster       OnefopVtTrainerRoster[]
  cooperativeDetail     OnefopCooperativeDetail?
  cspGenderAge          OnefopCspGenderAge[]
  ctdDetail             OnefopCtdDetail?
  departureData         OnefopDepartureData[]
  diplomaData           OnefopDiplomaData[]
  disabilityData        OnefopDisabilityData[]
  dismissalReasons      OnefopDismissalReason[]
  dismissalUnemployment OnefopDismissalUnemployment[]
  enterpriseDetail      OnefopEnterpriseDetail?
  factRecruitments      OnefopFactRecruitment[]
  factSkillNeeds        OnefopFactSkillNeed[]
  firstTimeWorkers      OnefopFirstTimeWorker[]
  internshipData        OnefopInternshipData[]
  jobApplicationData    OnefopJobApplicationData[]
  ongDetail             OnefopOngDetail?
  registeredSeekers     OnefopRegisteredSeeker[]
  respondent            OnefopRespondent?
  skillNeeds            OnefopSkillNeed[]
  company               Company?                      @relation(fields: [companyId], references: [id])
  establishment         Establishment                 @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  campaign              DataCampaign?                 @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  departmentRef         Department?                   @relation(fields: [departmentId], references: [id])
  regionRef             Region?                       @relation(fields: [regionId], references: [id])
  subdivisionRef        Subdivision?                  @relation(fields: [subdivisionId], references: [id])
  user                  User?                         @relation(fields: [submittedBy], references: [id])
  trainingNeeds         OnefopTrainingNeed[]
  vulnerableData        OnefopVulnerableData[]
  anomalies             OnefopAnomaly[]

  @@index([status])
  @@index([formType])
  @@index([surveyYear])
  @@index([region])
  @@index([submittedBy])
  @@index([establishmentId], map: "idx_onefop_submissions_establishmentId")
  @@index([quarterCode], map: "idx_onefop_submissions_quarterCode")
  @@index([taxNumber])
  @@index([cnpsNumber])
  @@index([companyId], map: "idx_onefop_submissions_companyId")
  @@index([campaignId])
  // Added for the SPSS/Excel bulk-export filters (DataManagementService) —
  // `department` and the `createdAt` from/to range were the only two
  // export filter columns without an index; at large submission counts
  // (many campaign cycles) an unindexed filter here forces a sequential
  // scan of the whole table.
  @@index([department])
  @@index([createdAt])
  @@map("onefop_submissions")
}

