generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model MinefopService {
  code               String            @id
  name               String
  nameEn             String?
  acronym            String?
  category           ServiceCategory
  level              Int
  parentCode         String?
  roleMapping        UserRole
  requiresRegion     Boolean           @default(false)
  requiresDepartment Boolean           @default(false)
  orderIndex         Int
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  parent             MinefopService?   @relation("ServiceHierarchy", fields: [parentCode], references: [code])
  children           MinefopService[]  @relation("ServiceHierarchy")
  positions          ServicePosition[]
  users              User[]

  @@map("minefop_services")
}

model ServicePosition {
  id           String         @id @default(uuid())
  serviceCode  String
  positionType String
  title        String
  titleEn      String?
  level        Int
  orderIndex   Int
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  service      MinefopService @relation(fields: [serviceCode], references: [code])

  @@unique([serviceCode, positionType])
  @@map("service_positions")
}

model Region {
  id                String             @id @default(uuid())
  name              String             @unique
  code              String?            @unique
  nameEn            String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  companies         Company[]
  departments       Department[]
  onefopSubmissions OnefopSubmission[]
  territoryTargets  TerritoryTarget[]
  campaignQuotas    CampaignQuota[]
  establishments    Establishment[]

  @@map("regions")
}

model Department {
  id                String             @id @default(uuid())
  name              String
  code              String?            @unique
  nameEn            String?
  regionId          String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  companies         Company[]
  region            Region             @relation(fields: [regionId], references: [id])
  onefopSubmissions OnefopSubmission[]
  subdivisions      Subdivision[]
  territoryTargets  TerritoryTarget[]
  campaignQuotas    CampaignQuota[]
  establishments    Establishment[]

  @@unique([regionId, name])
  @@map("departments")
}

model Subdivision {
  id                String             @id @default(uuid())
  name              String
  code              String?            @unique
  nameEn            String?
  departmentId      String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  companies         Company[]
  onefopSubmissions OnefopSubmission[]
  department        Department         @relation(fields: [departmentId], references: [id])
  establishments    Establishment[]

  @@unique([departmentId, name])
  @@map("subdivisions")
}

model Sector {
  id                    String                       @id @default(uuid())
  name                  String                       @unique
  code                  String?                      @unique
  category              String?
  nameEn                String?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  companies             Company[]
  onefopEnterprises     OnefopEnterpriseDetail[]
  onefopCooperatives    OnefopCooperativeDetail[]
  onefopCtds            OnefopCtdDetail[]
  onefopOngs            OnefopOngDetail[]
  onefopAdministrations OnefopAdministrationDetail[]
  onefopProjectPrograms OnefopProjectProgramDetail[]

  @@map("sectors")
}

model User {
  id                         String             @id @default(uuid())
  email                      String             @unique
  passwordHash               String
  firstName                  String?
  lastName                   String?
  role                       UserRole           @default(COMPANY)
  region                     String?
  department                 String?
  subdivision                String?
  matricule                  String?
  poste                      String?
  serviceCode                String?
  positionType               String?
  positionTitle              String?
  isActive                   Boolean            @default(true)
  rejectionReason            String?
  rejectedAt                 DateTime?
  passwordResetTokenHash     String?
  passwordResetExpires       DateTime?
  failedLoginAttempts        Int                @default(0)
  lockedUntil                DateTime?
  mustChangePassword         Boolean            @default(false)
  emailVerified              Boolean            @default(true)
  emailVerificationTokenHash String?
  emailVerificationExpires   DateTime?
  emailNotificationsEnabled  Boolean            @default(true)
  pushNotificationsEnabled   Boolean            @default(true)
  weeklyDigestEnabled        Boolean            @default(false)
  smsNotificationsEnabled    Boolean            @default(false)
  twoFactorEnabled           Boolean            @default(false)
  twoFactorCodeHash          String?
  twoFactorCodeExpires       DateTime?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  status                     UserStatus         @default(PENDING_APPROVAL)
  // ── Admin rebuild B1 (user & registration) — all nullable or defaulted.
  // See docs/deferred.md "Phase B1 — user & registration schema".
  lastLoginAt                DateTime?
  approvedAt                 DateTime?
  // Account that created this one (e.g. an admin-created MINEFOP agent);
  // null = self-registration or unknown.
  createdBy                  String?
  // Free text until the values settle (e.g. SELF_REGISTRATION, ADMIN_CREATED).
  registrationMethod         String?
  // Reserved for session invalidation ("réinitialiser la session"); not read yet.
  tokenVersion               Int                @default(0)
  // Human-readable registration number (e.g. INS-2026-0847); no generator yet.
  registrationNumber         String?            @unique
  // Agent the registration is assigned to for review.
  assigneeId                 String?
  lastReminderAt             DateTime?
  // Reviewer comment on approval / complements request (kept apart from rejectionReason).
  approvalComment            String?
  perAgentTarget             Int?
  createdByUser              User?              @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdUsers               User[]             @relation("UserCreatedBy")
  assignee                   User?              @relation("UserAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignedUsers              User[]             @relation("UserAssignee")
  registrationDocuments      RegistrationDocument[] @relation("RegistrationDocumentOwner")
  verifiedDocuments          RegistrationDocument[] @relation("RegistrationDocumentVerifier")
  auditLogs                  AuditLog[]
  batchJobs                  BatchJob[]
  company                    Company?
  createdCampaigns           DataCampaign[]     @relation("CampaignCreatedBy")
  distributionLists          DistributionList[]
  distributionLogs           DistributionLog[]
  notifications              Notification[]
  userNotifications          UserNotification[]
  onefopSubmissions          OnefopSubmission[]
  approvedReports            Report[]           @relation("ReportApprovedBy")
  generatedReports           Report[]
  scheduledReports           ScheduledReport[]
  submissionDrafts           SubmissionDraft[]
  closedRounds               SubmissionRound[]  @relation("RoundClosedBy")
  openedRounds               SubmissionRound[]  @relation("RoundOpenedBy")
  minefopService             MinefopService?    @relation(fields: [serviceCode], references: [code])
  resolvedAnomalies          OnefopAnomaly[]    @relation("AnomalyResolver")
  frozenCampaigns            CampaignFreeze[]   @relation("CampaignFrozenBy")
  territoryTargetsCreated          TerritoryTarget[]          @relation("TerritoryTargetCreatedBy")
  territoryTargetsUpdated          TerritoryTarget[]          @relation("TerritoryTargetUpdatedBy")
  campaignQuotasCreated            CampaignQuota[]            @relation("CampaignQuotaCreatedBy")
  campaignQuotasUpdated            CampaignQuota[]            @relation("CampaignQuotaUpdatedBy")
  centralInscriptionTargetsCreated CentralInscriptionTarget[] @relation("CentralInscriptionTargetCreatedBy")
  centralInscriptionTargetsUpdated CentralInscriptionTarget[] @relation("CentralInscriptionTargetUpdatedBy")
  centralCampaignQuotasCreated     CentralCampaignQuota[]     @relation("CentralCampaignQuotaCreatedBy")
  centralCampaignQuotasUpdated     CentralCampaignQuota[]     @relation("CentralCampaignQuotaUpdatedBy")

  @@index([role])
  @@index([serviceCode])
  @@index([status])
  @@index([createdBy])
  @@index([assigneeId])
  @@map("users")
}

// One row per document a registrant must provide (Figma "Documents
// fournis": attestation d'enregistrement, pièce d'identité, certificat
// d'imposition…). A row with no fileRef is an expected document that has
// not been provided ("Manquant").
model RegistrationDocument {
  id         String    @id @default(uuid())
  userId     String
  // Document type code; free text until the list per entity type is ruled.
  kind       String
  // Supabase Storage object path, signed on read — same pattern as
  // Company.attestationUrl (PdfService.getSignedUrlForPath). No bytes here.
  fileRef    String?
  // PENDING | VERIFIED | REJECTED | MISSING — free text until the workflow settles.
  state      String    @default("PENDING")
  uploadedAt DateTime?
  verifiedAt DateTime?
  verifiedBy String?
  // Restrict: deleting a registrant with documents answers 409 (deleteUser
  // maps P2003), the same as a user with a company or submissions.
  user       User      @relation("RegistrationDocumentOwner", fields: [userId], references: [id], onDelete: Restrict)
  verifier   User?     @relation("RegistrationDocumentVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([verifiedBy])
  @@map("registration_documents")
}

model Company {
  id                         String                  @id @default(uuid())
  userId                     String                  @unique
  name                       String
  parentCompany              String?
  mainActivity               String
  secondaryActivity          String?
  region                     String
  department                 String
  subdivision                String
  address                    String
  taxNumber                  String                  @unique
  cnpsNumber                 String?
  socialCapital              Float?
  totalEmployees             Int
  menCount                   Int?
  womenCount                 Int?
  lastYearTotal              Int?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  fax                        String?
  lastYearMenCount           Int?
  lastYearWomenCount         Int?
  entityType                 OnefopEntityType?
  sectorId                   String?
  regionId                   String?
  departmentId               String?
  subdivisionId              String?
  area                       String?
  cooperativeType            String?
  ctdType                    String?
  legalStatus                String?
  mainMission                String?
  phone                      String?
  phone2                     String?
  poBox                      String?
  registrationNumber         String?
  respondentFunction         String?
  respondentPhone            String?
  respondentPhone2           String?
  trainingDomains            String?
  yearOfCreation             String?
  branch                     String?
  respondentFirstName        String?
  respondentLastName         String?
  enterpriseSize             String?
  // Vocational Training (VT) registration-time identification — verbatim
  // option lists from the source questionnaire, plain strings (no VT enum
  // backs them, matching onefop_ast.dart's own posture on these fields).
  // Distinct from the unrelated vocationalCenter entity type, which has no
  // fields here beyond the generic ones above.
  sigle                      String?
  cfpType                    String?
  educationSystem            String?
  functionalStatus           String?
  nonFunctionalReason        String?
  nonFunctionalReasonOther   String?
  // 1.16 — Promoteur/Directeur du CFP, a second contact block distinct
  // from respondentFirstName/respondentLastName/respondentPhone(2) above
  // (1.15). VT-only; no other entity type populates these.
  promoterName               String?
  promoterSex                String?
  promoterPhone1             String?
  promoterPhone2             String?
  // Unique: the ID is the establishment's public identifier, printed on the
  // attestation and used as a search key. Allocation is serialised by
  // pg_advisory_xact_lock in EstablishmentIdGenerator; this is the database
  // backstop behind it. Nullable, and Postgres allows repeated NULLs, so
  // companies still awaiting approval are unaffected.
  establishmentId            String?                 @unique
  establishmentIdGeneratedAt DateTime?               @db.Timestamp(6)
  attestationUrl             String?
  attestationGeneratedAt     DateTime?               @db.Timestamp(6)
  campaignSubmissions        CampaignSubmission[]
  departmentRef              Department?             @relation(fields: [departmentId], references: [id])
  regionRef                  Region?                 @relation(fields: [regionId], references: [id])
  sector                     Sector?                 @relation(fields: [sectorId], references: [id])
  subdivisionRef             Subdivision?            @relation(fields: [subdivisionId], references: [id])
  user                       User                    @relation(fields: [userId], references: [id])
  declarations               Declaration[]
  notificationRecipients     NotificationRecipient[]
  onefopSubmissions          OnefopSubmission[]
  dsmoDeclarationDraft       DsmoDeclarationDraft?
  establishments             Establishment[]

  @@index([establishmentId], map: "idx_companies_establishmentId")
  @@index([regionId])
  @@index([departmentId])
  @@map("companies")
}

enum EstablishmentStatus {
  ACTIVE
  CLOSED
  SUSPENDED
}

model Establishment {
  id              String               @id @default(uuid())
  code            String               @unique // e.g. EN26000100-01 (13 chars)
  name            String               // Site label, e.g. "Siège Social" / "Usine de Bonabéri"
  isPrincipal     Boolean              @default(false)
  status          EstablishmentStatus  @default(ACTIVE)

  companyId       String
  company         Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)

  // Territory hierarchy (canonical FKs + denormalized text)
  regionId        String
  departmentId    String
  subdivisionId   String
  regionRef       Region               @relation(fields: [regionId], references: [id])
  departmentRef   Department           @relation(fields: [departmentId], references: [id])
  subdivisionRef  Subdivision          @relation(fields: [subdivisionId], references: [id])
  region          String
  department      String
  subdivision     String
  address         String
  phone           String?
  email           String?

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  submissions     OnefopSubmission[]
  campaignTargets CampaignSubmission[]

  @@index([companyId])
  @@index([regionId])
  @@index([departmentId])
  @@index([subdivisionId])
  @@map("establishments")
}

/// In-progress DSMO declaration data, saved client-side (autosave + explicit
/// "resume draft" flow in DeclarationWizardScreen) before the company
/// completes the real POST /dsmo/declaration submission. One per company —
/// a fresh draft overwrites the previous one. Mirrors OneFOP's
/// SubmissionDraft, but does not touch the Declaration/DeclarationStatus
/// pipeline at all, so it can't interfere with the legally-binding submit
/// flow in DsmoService.submitDeclaration.
model DsmoDeclarationDraft {
  id        String   @id @default(uuid())
  companyId String   @unique
  year      Int
  draftData Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])

  @@map("dsmo_declaration_drafts")
}

model Declaration {
  id                   String                @id @default(uuid())
  year                 Int
  companyId            String
  region               String
  division             String
  status               DeclarationStatus     @default(DRAFT)
  submittedAt          DateTime?
  validatedBy          String?
  validatedAt          DateTime?
  rejectionReason      String?
  pdfUrl               String?
  receiptUrl           String?
  qrCode               String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  fillingDate          DateTime?
  // Campaign this declaration was filed under (campaign progress, phase B1).
  // Nullable: pre-existing rows and declarations filed outside a campaign
  // have none. Nothing writes it yet.
  campaignId           String?
  auditLogs            AuditLog[]
  movements            DeclarationMovement[]
  company              Company               @relation(fields: [companyId], references: [id])
  campaign             DataCampaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  employees            Employee[]
  qualitativeQuestions QualitativeQuestion[]
  validationSteps      ValidationStep[]

  // (companyId, year, status) covers the existence/draft lookups that run on
  // every DSMO declaration submission (see DsmoService.submitDeclaration).
  @@index([companyId, year, status])
  @@index([status])
  @@index([region])
  @@index([division])
  @@index([year])
  @@index([createdAt])
  @@index([submittedAt])
  @@index([campaignId])
  @@map("declarations")
}

model Employee {
  id             String      @id @default(uuid())
  declarationId  String
  fullName       String
  gender         String
  age            Int
  nationality    String
  diploma        String?
  function       String
  seniority      Int
  salaryCategory String?
  createdAt      DateTime    @default(now())
  salary         Int?
  declaration    Declaration @relation(fields: [declarationId], references: [id])

  @@index([declarationId])
  @@map("employees")
}

model DeclarationMovement {
  id             String       @id @default(uuid())
  declarationId  String
  movementType   MovementType
  cat1_3         Int          @default(0)
  cat4_6         Int          @default(0)
  cat7_9         Int          @default(0)
  cat10_12       Int          @default(0)
  catNonDeclared Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  declaration    Declaration  @relation(fields: [declarationId], references: [id])

  @@index([declarationId])
  @@map("declaration_movements")
}

model ValidationStep {
  id            String             @id @default(uuid())
  declarationId String
  stepType      ValidationStepType
  isValid       Boolean            @default(true)
  errors        String[]           @default([])
  message       String?
  checkedBy     String?
  checkedAt     DateTime?
  createdAt     DateTime           @default(now())
  declaration   Declaration        @relation(fields: [declarationId], references: [id])

  @@index([declarationId])
  @@map("validation_steps")
}

model QualitativeQuestion {
  id                    String      @id @default(uuid())
  declarationId         String
  questionType          String
  section               String
  questionText          String
  answerText            String?
  answerOptions         Json?
  hasTrainingCenter     Boolean?
  trainingCenterDetails String?
  recruitmentPlansNext  Boolean?
  recruitmentPlanCount  Int?
  camerounisationPlan   Boolean?
  usesTempAgencies      Boolean?
  temporaryWorkerCount  Int?
  version               Int         @default(1)
  orderIndex            Int         @default(0)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  tempAgencyDetails     String?
  declaration           Declaration @relation(fields: [declarationId], references: [id])

  @@index([declarationId])
  @@map("qualitative_questions")
}

model Notification {
  id               String                  @id @default(uuid())
  sentBy           String
  regionFilter     String?
  departmentFilter String?
  submissionStatus DeclarationStatus?
  subject          String
  message          String
  recipientCount   Int                     @default(0)
  sentAt           DateTime                @default(now())
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  recipients       NotificationRecipient[]
  senderUser       User                    @relation(fields: [sentBy], references: [id])

  @@index([regionFilter])
  @@index([sentAt])
  @@map("notifications")
}

model NotificationRecipient {
  id             String             @id @default(uuid())
  notificationId String
  companyId      String
  email          String
  status         NotificationStatus @default(SENT)
  sentAt         DateTime           @default(now())
  openedAt       DateTime?
  clickedAt      DateTime?
  createdAt      DateTime           @default(now())
  company        Company            @relation(fields: [companyId], references: [id])
  notification   Notification       @relation(fields: [notificationId], references: [id])

  @@index([notificationId])
  @@index([companyId])
  @@map("notification_recipients")
}

/// In-app notification addressed to ONE user, with read state.
///
/// Distinct from `Notification` above, which is an outbound-email audit log:
/// per-campaign rather than per-user, no inbox, no read state. This is the
/// inbox a user sees when they next log in — email delivery is unreliable on
/// this deployment, so in-app is the channel, not a fallback.
///
/// `kind` is free text so a new notification type needs no migration
/// (DECISION 3 ships NUDGE alone; APPROVAL/REJECTION/ASSIGNMENT come later).
///
/// Mirrors prisma/migrations/20261006120000_user_notifications/migration.sql.
model UserNotification {
  id        String    @id @default(uuid())
  userId    String
  /// 'NUDGE' | 'ASSIGNMENT' | 'APPROVAL' | …
  kind      String
  subject   String
  body      String    @db.Text
  /// Optional in-app link target, e.g. /admin/dossiers.
  linkHref  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("user_notifications")
}

model AuditLog {
  id            String       @id @default(uuid())
  userId        String
  declarationId String?
  action        String
  resourceType  String
  resourceId    String
  details       Json?
  previousValue String?
  newValue      String?
  timestamp     DateTime     @default(now())
  createdAt     DateTime     @default(now())
  reportId      String?
  ipAddress     String?
  userAgent     String?
  declaration   Declaration? @relation(fields: [declarationId], references: [id])
  user          User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([declarationId])
  @@index([timestamp])
  @@index([action])
  @@index([reportId])
  @@map("audit_logs")
}

model DataCampaign {
  id                String               @id @default(uuid())
  description       String?
  startDate         DateTime?
  endDate           DateTime?
  createdBy         String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  autoReminders     Boolean              @default(false)
  closedAt          DateTime?
  code              String               @unique
  deadline          DateTime?
  extendedDeadline  DateTime?
  name              String
  referenceYear     Int?
  referenceQuarter  Int?
  reminderDays      Int[]                @default([])
  targetDepartments String[]             @default([])
  targetEntityTypes String[]             @default([])
  targetRegions     String[]             @default([])
  // Renamed from `type`. The legacy wire key `type` is still emitted by the
  // response mappers in src/campaign/campaign.service.ts for backward
  // compatibility, and will be dropped once react-web, the Flutter admin and
  // the Flutter company workspace all read `periodicity`.
  periodicity       CampaignPeriodicity?
  purpose           CampaignPurpose      @default(COLLECTION)
  // Which form this campaign actually gates — drives the SubmissionRound
  // opened/closed alongside the campaign's lifecycle (see SubmissionRound.module).
  collectionType    SubmissionModule     @default(ONEFOP)
  status            CampaignStatus       @default(DRAFT)
  reminders         CampaignReminder[]
  submissions       CampaignSubmission[]
  freezes           CampaignFreeze[]
  creator           User?                @relation("CampaignCreatedBy", fields: [createdBy], references: [id])
  round             SubmissionRound?
  onefopSubmissions OnefopSubmission[]
  declarations      Declaration[]
  quotas            CampaignQuota[]
  centralQuota      CentralCampaignQuota?

  @@index([status])
  @@map("data_campaigns")
}

model CampaignSubmission {
  id              String           @id @default(uuid())
  campaignId      String
  companyId       String?
  submittedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  establishmentId String
  status          SubmissionStatus @default(PENDING)
  campaign        DataCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  establishment   Establishment    @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  @@unique([campaignId, establishmentId])
  @@index([campaignId])
  @@index([companyId])
  @@index([establishmentId])
  @@map("campaign_submissions")
}

model CampaignReminder {
  id             String       @id @default(uuid())
  campaignId     String
  sentAt         DateTime     @default(now())
  message        String?
  createdAt      DateTime     @default(now())
  recipientCount Int          @default(0)
  failedCount    Int          @default(0)
  reminderType   String       @default("INITIAL")
  subject        String?
  campaign       DataCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("campaign_reminders")
}

model Report {
  id               String            @id @default(uuid())
  parameters       Json?
  fileUrl          String?
  createdBy        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  expiresAt        DateTime?
  isScheduled      Boolean           @default(false)
  name             String
  schedule         String?
  type             ReportType?
  reportType       ReportType?
  format           ReportFormat
  status           String            @default("READY")
  filePath         String?
  fileHash         String?
  approvalStatus   String?           @default("PENDING")
  approvedBy       String?
  approvedAt       DateTime?
  rejectionReason  String?
  distributionLogs DistributionLog[]
  snapshot         ReportSnapshot?
  approvedByUser   User?             @relation("ReportApprovedBy", fields: [approvedBy], references: [id], onUpdate: NoAction)
  createdByUser    User?             @relation(fields: [createdBy], references: [id])
  scheduledReports ScheduledReport[]

  @@index([reportType])
  @@index([fileHash], map: "idx_reports_fileHash")
  @@index([approvalStatus])
  @@index([approvedBy])
  @@map("reports")
}

model ReportSnapshot {
  id            String    @id @default(cuid())
  reportId      String    @unique
  computedAt    DateTime  @default(now()) @db.Timestamptz(6)
  snapshotData  Json
  sourceHash    String
  submissionIds String[]  @default([])
  approvedBy    String?
  approvedAt    DateTime?
  approvalHash  String?
  report        Report    @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "report_snapshots_reportid_fkey")

  @@map("report_snapshots")
}

model ScheduledReport {
  id            String       @id @default(uuid())
  parameters    Json?
  schedule      String
  isActive      Boolean      @default(true)
  lastRunAt     DateTime?
  createdBy     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  frequency     String?
  recipients    String[]     @default([])
  reportId      String?
  reportType    ReportType
  format        ReportFormat
  createdByUser User?        @relation(fields: [createdBy], references: [id])
  report        Report?      @relation(fields: [reportId], references: [id])

  @@index([reportType])
  @@map("scheduled_reports")
}

model SubmissionRound {
  id                String             @id @default(uuid())
  quarterCode       String             @unique
  labelFr           String
  labelEn           String
  periodStart       DateTime
  periodEnd         DateTime
  deadline          DateTime
  status            RoundStatus        @default(DRAFT)
  targetRegions     String[]           @default([])
  targetEntityTypes OnefopEntityType[] @default([])
  // Which form this round actually opens/closes submission for. Rounds are
  // scoped per module so an ONEFOP round and a DSMO round can be open
  // simultaneously without one closing the other.
  module            SubmissionModule   @default(ONEFOP)
  // Set when this round was opened/closed by a DataCampaign's lifecycle
  // rather than directly via the admin Submission Rounds screen.
  campaignId        String?            @unique
  openedBy          String?
  openedAt          DateTime?
  closedBy          String?
  closedAt          DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  campaign          DataCampaign?      @relation(fields: [campaignId], references: [id])
  closedByUser      User?              @relation("RoundClosedBy", fields: [closedBy], references: [id])
  openedByUser      User?              @relation("RoundOpenedBy", fields: [openedBy], references: [id])

  @@index([status])
  @@index([module, status])
  @@index([deadline])
  @@index([quarterCode])
  @@map("submission_rounds")
}

