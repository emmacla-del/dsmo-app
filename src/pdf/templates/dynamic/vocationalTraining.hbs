<!DOCTYPE html>
<html lang="{{lang}}">

<head>
    <meta charset="UTF-8">
    <title>Recensement Annuel de la Formation Professionnelle {{surveyYear}}</title>
    <style>
        /* No @page rule here — page size/margins are controlled entirely by
           OnefopPuppeteerService's page.pdf({format:'A4', margin:'15mm'})
           call, matching every other dynamic/*.hbs template. A template-level
           @page rule would compete with that call rather than complement it. */

        * {
            box-sizing: border-box;
        }

        body {
            font-family: "Arial", "Helvetica", sans-serif;
            font-size: 9.5px;
            color: #111;
            margin: 0;
        }

        .page {
            page-break-after: always;
            padding: 4px 2px;
        }

        .page:last-child {
            page-break-after: auto;
        }

        /* ---------- Header ---------- */
        .header-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 6px;
        }

        .header-table td {
            vertical-align: top;
            text-align: center;
            font-size: 9px;
            font-weight: bold;
            width: 30%;
        }

        .header-table td.logo {
            width: 40%;
        }

        .header-table img {
            height: 55px;
        }

        .title-box {
            border: 2px solid #0aa1c0;
            border-radius: 14px;
            padding: 8px 14px;
            text-align: center;
            margin-bottom: 6px;
        }

        .title-box h1 {
            font-size: 12px;
            margin: 2px 0;
        }

        .title-box h2 {
            font-size: 10px;
            font-style: italic;
            font-weight: normal;
            margin: 2px 0;
        }

        .warning-box {
            border: 1px solid #000;
            padding: 4px 6px;
            font-size: 7.6px;
            margin-bottom: 6px;
        }

        .warning-box u {
            font-weight: bold;
        }

        /* ---------- Section headers ---------- */
        .section-title {
            background: #d9d9d9;
            border: 1px solid #000;
            text-align: center;
            font-weight: bold;
            font-size: 10px;
            padding: 4px;
            margin: 8px 0 0 0;
        }

        .section-title .en {
            font-style: italic;
            font-weight: normal;
            display: block;
            font-size: 9px;
        }

        /* ---------- Generic bordered field grid (Section 1 style) ---------- */
        table.field-grid {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 4px;
        }

        table.field-grid td,
        table.field-grid th {
            border: 1px solid #000;
            padding: 3px 4px;
            vertical-align: top;
        }

        .field-num {
            width: 3%;
            font-weight: bold;
            text-align: center;
        }

        .field-label {
            width: 40%;
        }

        .field-label .fr {
            display: block;
        }

        .field-label .en {
            display: block;
            font-style: italic;
        }

        .field-value {
            width: 20%;
        }

        .field-boxes {
            text-align: center;
        }

        .fill-line {
            display: inline-block;
            min-width: 40px;
            border-bottom: 1px dotted #333;
            padding: 0 2px;
        }

        /* boxed digit cells, e.g. I__I__I__I */
        .digit-boxes {
            white-space: nowrap;
        }

        .digit-boxes .box {
            display: inline-block;
            width: 13px;
            height: 14px;
            border: 1px solid #000;
            text-align: center;
            margin-right: 1px;
            font-size: 9px;
            line-height: 14px;
        }

        /* Yes/No radio pair */
        .yesno {
            white-space: nowrap;
        }

        .yesno .opt {
            display: inline-block;
            margin-right: 10px;
        }

        .yesno .circle {
            display: inline-block;
            width: 10px;
            height: 10px;
            border: 1px solid #000;
            border-radius: 50%;
            margin-right: 3px;
            vertical-align: middle;
        }

        .yesno .circle.checked {
            background: #000;
        }

        .checkbox {
            display: inline-block;
            width: 9px;
            height: 9px;
            border: 1px solid #000;
            margin-right: 3px;
            vertical-align: middle;
        }

        .checkbox.checked {
            background: #000;
        }

        /* ---------- Data tables (Sections 4/5/8 style) ---------- */
        table.data-table {
            width: 100%;
            border-collapse: collapse;
            margin: 4px 0 8px 0;
        }

        table.data-table th,
        table.data-table td {
            border: 1px solid #000;
            padding: 2px 3px;
            text-align: center;
            font-size: 9px;
        }

        table.data-table th {
            background: #eee;
            font-weight: bold;
        }

        table.data-table td.rowlabel {
            text-align: left;
        }

        table.data-table tfoot td {
            font-weight: bold;
            background: #f5f5f5;
        }

        .nb-note {
            font-size: 8px;
            font-style: italic;
            margin: 2px 0 8px 0;
        }

        .legend {
            font-size: 7px;
            color: #333;
            margin: 2px 0 8px 0;
            line-height: 1.4;
        }

        .signature-row {
            width: 100%;
            margin-top: 30px;
        }

        .signature-row table {
            width: 100%;
        }

        .signature-row td {
            width: 33%;
            text-align: center;
            vertical-align: top;
            font-size: 8.5px;
            padding-top: 40px;
            border-top: 1px solid #000;
        }
    
        /* i18n language filtering */
        html[lang="fr"] .en,
        html[lang="fr"] .en-inline {
            display: none !important;
        }
        html[lang="en"] .fr,
        html[lang="en"] .fr-inline {
            display: none !important;
        }
    </style>
</head>

<body>

    {{!-- =====================================================================
    Reusable partials expected to be registered on the Handlebars env:
    pageHeader - ministry header + title block (all pages)
    Helpers expected:
    yesno value -> renders Oui/Non circles, "value" is boolean|null
    checkbox checked -> renders a tickbox
    digitBoxes value length -> renders N boxed-digit cells, filled from value
    eq a b -> equality helper for radio/select comparisons
    inc index -> index+1, for 1-based row numbering in each
    ===================================================================== --}}

    <!-- ============================================================ -->
    <!-- PAGE 1 : COVER + SECTION 1 IDENTIFICATION                     -->
    <!-- ============================================================ -->
    <div class="page">

        <table class="header-table">
            <tr>
                <td>
                    REPUBLIQUE DU CAMEROUN<br>Paix &ndash; Travail &ndash; Patrie<br>-----------<br>
                    MINISTERE DE L'EMPLOI ET DE LA FORMATION PROFESSIONNELLE<br>-----------
                </td>
                <td class="logo">{{#if armoiriesBase64}}<img src="{{armoiriesBase64}}" alt="Armoiries">{{/if}}</td>
                <td>
                    REPUBLIC OF CAMEROON<br>Peace &ndash; Work &ndash; Fatherland<br>-----------<br>
                    MINISTRY OF EMPLOYMENT AND VOCATIONAL TRAINING<br>-----------
                </td>
            </tr>
        </table>

        <div class="title-box">
            <h1><span class="fr">RECENSEMENT ANNUEL DE LA FORMATION PROFESSIONNELLE {{surveyYear}}</span><span class="en">ANNUAL VOCATIONAL TRAINING SURVEY {{surveyYear}}</span></h1>
            <h2><span class="fr">QUESTIONNAIRE DE COLLECTE DE DONNEES AUPRES DES CFP PUBLICS ET PRIVES</span><span class="en">QUESTIONNAIRE FOR DATA COLLECTION FROM PUBLIC AND PRIVATE VTCs</span></h2>
            <div style="font-size:7.5pt;color:#1F3864;margin-top:4px;font-weight:bold;letter-spacing:0.3px;">{{#if officialBannerText}}{{officialBannerText}}{{else}}Formulaire officiel ONEFOP &middot; Document g&eacute;n&eacute;r&eacute; via la plateforme CAM-LEAP{{/if}}</div>
        </div>

        <div class="warning-box">
            <span class="fr"><u>AVERTISSEMENT</u><br>Les informations contenues dans ce document sont confidentielles et ne pourront être utilisées à des fins de poursuites judiciaires, de contrôle fiscal ou de répression économique, conformément à la Loi N&deg; 2020/010 du 20 juillet 2020 relative aux recensements et enquêtes Statistiques.</span>
            <span class="en"><u>WARNING</u><br>The information contained in this document is strictly confidential and cannot be used for purposes of legal proceedings, tax audit or economic repression, in accordance with Law No. 2020/010 of 20 July 2020 on censuses and statistical surveys.</span>
        </div>

        <div class="section-title">
            <span class="fr">SECTION 1 : IDENTIFICATION ET LOCALISATION DE LA STRUCTURE</span>
            <span class="en">SECTION 1: IDENTIFICATION AND LOCALISATION OF TRAINING CENTER</span>
        </div>

        <table class="field-grid">
            <tr>
                <td class="field-num">1.1</td>
                <td class="field-label"><span class="fr">Code de la structure (à ne pas remplir)</span><span class="en">Structure code (not to be filled in)</span></td>
                <td colspan="2">{{digitBoxes identification.structureCode 13}}</td>
            </tr>
            <tr>
                <td class="field-num">1.2</td>
                <td class="field-label"><span class="fr">Nom du CFP</span><span class="en">Name of VTC</span></td>
                <td colspan="2">{{identification.nomCFP}}</td>
            </tr>
            <tr>
                <td class="field-num">1.3</td>
                <td class="field-label"><span class="fr">Sigle</span><span class="en">Initials</span></td>
                <td colspan="2">{{identification.sigle}}</td>
            </tr>
            <tr>
                <td class="field-num">1.4</td>
                <td class="field-label"><span class="fr">Région</span><span class="en">Region</span></td>
                <td>{{identification.region.name}}</td>
                <td>{{digitBoxes identification.region.code 2}}</td>
            </tr>
            <tr>
                <td class="field-num">1.5</td>
                <td class="field-label"><span class="fr">Département</span><span class="en">Division</span></td>
                <td>{{identification.departement.name}}</td>
                <td>{{digitBoxes identification.departement.code 2}}</td>
            </tr>
            <tr>
                <td class="field-num">1.6</td>
                <td class="field-label"><span class="fr">Arrondissement</span><span class="en">Sub-Division</span></td>
                <td>{{identification.arrondissement.name}}</td>
                <td>{{digitBoxes identification.arrondissement.code 4}}</td>
            </tr>
            <tr>
                <td class="field-num">1.7</td>
                <td class="field-label"><span class="fr">Commune</span><span class="en">Council</span></td>
                <td colspan="2">{{identification.commune}}</td>
            </tr>
            <tr>
                <td class="field-num">1.8</td>
                <td class="field-label"><span class="fr">Village-Quartier</span><span class="en">Village-Quarter</span>
                </td>
                <td colspan="2">{{identification.villageQuartier}}</td>
            </tr>
            <tr>
                <td class="field-num">1.9</td>
                <td class="field-label"><span class="fr">Milieu d'implantation</span><span class="en">Area of
                        residence</span></td>
                <td colspan="2">
                    <span class="yesno">
                        <span class="opt"><span
                                class="circle {{#if (eq identification.milieu 'urbain')}}checked{{/if}}"></span><span class="fr">1 = Urbain</span><span class="en">1 = Urban</span></span>
                        <span class="opt"><span
                                class="circle {{#if (eq identification.milieu 'rural')}}checked{{/if}}"></span><span class="fr">2 = Rural</span><span class="en">2 = Rural</span></span>
                    </span>
                </td>
            </tr>
            <tr>
                <td class="field-num">1.10</td>
                <td class="field-label"><span class="fr">Ordre d'enseignement de la Structure</span><span
                        class="en">Education system of the training institution</span></td>
                <td colspan="2">
                    {{#each ordreEnseignementOptions}}
                    <div>{{checkbox (eq ../identification.ordreEnseignement value)}} {{label}}</div>
                    {{/each}}
                </td>
            </tr>
            <tr>
                <td class="field-num">1.11</td>
                <td class="field-label"><span class="fr">Type de CFP</span><span class="en">Type of VTC</span></td>
                <td colspan="2">
                    {{#each typeCFPOptions}}
                    <div>{{checkbox (eq ../identification.typeCFP value)}} {{label}}</div>
                    {{/each}}
                </td>
            </tr>
            <tr>
                <td class="field-num">1.12</td>
                <td class="field-label"><span class="fr">Situation du Centre de formation</span><span
                        class="en">Description of training center</span></td>
                <td colspan="2">
                    <div>{{checkbox (eq identification.situation 'fonctionnelle')}} <span class="fr">1 = Fonctionnelle</span><span class="en">1 = Functional</span></div>
                    <div>{{checkbox (eq identification.situation 'non-fonctionnelle')}} <span class="fr">2 = Non-fonctionnelle</span><span class="en">2 = Non-functional</span></div>
                    <div>{{checkbox (eq identification.situation 'fermee')}} <span class="fr">3 = Fermée</span><span class="en">3 = Closed</span></div>
                </td>
            </tr>
            {{#if (eq identification.situation 'non-fonctionnelle')}}
            <tr>
                <td class="field-num">1.13</td>
                <td class="field-label"><span class="fr">Si « Non-fonctionnelle », préciser la raison</span><span
                        class="en">If Non-functional, state the reason</span></td>
                <td colspan="2">
                    {{#each raisonNonFonctionnelleOptions}}
                    <div>{{checkbox (eq ../identification.raisonNonFonctionnelle value)}} {{label}}</div>
                    {{/each}}
                    {{#if (eq identification.raisonNonFonctionnelle 'autres')}}
                    <div>Autres (préciser) : {{identification.raisonAutrePrecision}}</div>
                    {{/if}}
                </td>
            </tr>
            {{/if}}
            <tr>
                <td class="field-num">1.14</td>
                <td class="field-label"><span class="fr">Année d'ouverture</span><span class="en">Year of
                        establishment</span></td>
                <td colspan="2">{{digitBoxes identification.anneeOuverture 4}}</td>
            </tr>
        </table>

        <table class="field-grid">
            <tr>
                <th colspan="2"><span class="fr">1.15. Informations sur le répondant</span><span class="en">1.15. Respondent information</span></th>
                <th colspan="2"><span class="fr">1.16. Noms et contacts du Promoteur/Directeur du CFP</span><span class="en">1.16. Name and contact of Head/Promoter of VTC</span></th>
            </tr>
            <tr>
                <td colspan="2"><span class="fr">Qualité du répondant</span><span class="en">Respondent's title</span> : {{identification.respondent.qualite}}</td>
                <td colspan="2"><span class="fr">Noms et prénoms</span><span class="en">Full name</span> : {{identification.promoteur.nomPrenoms}}</td>
            </tr>
            <tr>
                <td colspan="2"><span class="fr">Noms et prénoms</span><span class="en">Full name</span> : {{identification.respondent.nomPrenoms}}</td>
                <td colspan="2">
                    <span class="fr">Sexe :</span><span class="en">Sex:</span>
                    {{checkbox (eq identification.promoteur.sexe 'M')}} <span class="fr">Masculin</span><span class="en">Male</span>
                    {{checkbox (eq identification.promoteur.sexe 'F')}} <span class="fr">Féminin</span><span class="en">Female</span>
                </td>
            </tr>
            <tr>
                <td colspan="2">
                    <span class="fr">Sexe :</span><span class="en">Sex:</span>
                    {{checkbox (eq identification.respondent.sexe 'M')}} <span class="fr">Masculin</span><span class="en">Male</span>
                    {{checkbox (eq identification.respondent.sexe 'F')}} <span class="fr">Féminin</span><span class="en">Female</span>
                </td>
                <td colspan="2"><span class="fr">Téléphone 1 (WhatsApp)</span><span class="en">Phone 1 (WhatsApp)</span> : {{identification.promoteur.telephone1}} &nbsp; <span class="fr">Téléphone 2</span><span class="en">Phone 2</span> :
                    {{identification.promoteur.telephone2}}</td>
            </tr>
            <tr>
                <td colspan="2"><span class="fr">Téléphone (WhatsApp)</span><span class="en">Phone (WhatsApp)</span> : {{identification.respondent.telephone1}} &nbsp; <span class="fr">Téléphone 2</span><span class="en">Phone 2</span> :
                    {{identification.respondent.telephone2}}</td>
                <td colspan="2"><span class="fr">Email</span><span class="en">Email</span> : {{identification.promoteur.email}}</td>
            </tr>
        </table>
    </div>

    <!-- ============================================================ -->
    <!-- PAGE 2 : SECTION 2 INFORMATIONS GENERALES SUR L'ETABLISSEMENT -->
    <!-- ============================================================ -->
    <div class="page">
        <div class="section-title">
            <span class="fr">SECTION 2 : INFORMATIONS GENERALES SUR L'ETABLISSEMENT</span>
            <span class="en">SECTION 2: GENERAL INFORMATION</span>
        </div>

        <h3><span class="fr">2.1 Renseignements généraux</span><span class="en">2.1 General Information</span></h3>
        <table class="field-grid">
            <tr>
                <td class="field-num">2.1.1</td>
                <td class="field-label">Votre structure dispose-t-elle d'une convention avec l'Etat ?</td>
                <td colspan="2">{{yesno general.conventionEtat}}</td>
            </tr>
            {{#if general.conventionEtat}}
            <tr>
                <td class="field-num">2.1.2</td>
                <td class="field-label">Si oui, préciser le(s) type(s)</td>
                <td colspan="2">
                    {{#each conventionTypeOptions}}
                    <div>{{checkbox (includes ../general.conventionTypes value)}} {{label}}</div>
                    {{/each}}
                </td>
            </tr>
            {{/if}}
            <tr>
                <td class="field-num">2.1.3</td>
                <td class="field-label">Nombre de sites occupés par votre structure</td>
                <td colspan="2">{{digitBoxes general.nombreSites 2}}</td>
            </tr>
            <tr>
                <td class="field-num">2.1.4</td>
                <td class="field-label">Utilise-t-il des infrastructures en commun avec un autre établissement ?</td>
                <td colspan="2">{{yesno general.infrastructureCommune}}</td>
            </tr>
            {{#if general.infrastructureCommune}}
            <tr>
                <td class="field-num">2.1.5</td>
                <td class="field-label">Si oui, nom de l'établissement</td>
                <td colspan="2">{{general.etablissementPartageNom}}</td>
            </tr>
            {{/if}}
            <tr>
                <td class="field-num">2.1.6</td>
                <td class="field-label">Formateurs formés à l'accueil des enfants à besoins éducatifs spéciaux ?</td>
                <td colspan="2">{{yesno general.formateursBesoinsSpeciaux}}</td>
            </tr>
            {{#if general.formateursBesoinsSpeciaux}}
            <tr>
                <td class="field-num">2.1.7</td>
                <td class="field-label">Effectif de ces formateurs</td>
                <td>Total : {{digitBoxes general.effectifFormateursSpeciaux.total 3}}</td>
                <td>Femmes : {{digitBoxes general.effectifFormateursSpeciaux.femmes 3}}</td>
            </tr>
            {{/if}}
            <tr>
                <td class="field-num">2.1.8</td>
                <td class="field-label">Rampes d'accès pour enfants à motricité réduite ?</td>
                <td colspan="2">{{yesno general.rampesAcces}}</td>
            </tr>
            <tr>
                <td class="field-num">2.1.9</td>
                <td class="field-label">Existe-t-il un bureau pour le directeur ?</td>
                <td colspan="2">{{yesno general.bureauDirecteur}}</td>
            </tr>
            <tr>
                <td class="field-num">2.1.10</td>
                <td class="field-label">Boîte postale</td>
                <td>{{digitBoxes general.boitePostale 5}}</td>
                <td>Ville : {{general.ville}}</td>
            </tr>
            <tr>
                <td class="field-num">2.1.11</td>
                <td class="field-label">Email</td>
                <td colspan="2">{{general.email}}</td>
            </tr>
            <tr>
                <td class="field-num">2.1.12</td>
                <td class="field-label">Site Web</td>
                <td colspan="2">{{general.siteWeb}}</td>
            </tr>
            <tr>
                <td class="field-num">2.1.13</td>
                <td class="field-label">Êtes-vous agréé ?</td>
                <td colspan="2">
                    {{yesno general.agree}}
                    {{#if general.agree}}
                    <br>Année du dernier agrément : {{digitBoxes general.anneeAgrement 4}}
                    &nbsp; Arrêté n&deg; {{general.arreteNumero}} du {{general.arreteDate}}
                    {{/if}}
                </td>
            </tr>
            <tr>
                <td class="field-num">2.1.14</td>
                <td class="field-label">Types de formation dispensés</td>
                <td colspan="2">
                    <div>{{checkbox (includes general.typesFormation 'FI')}} Formation Initiale (FI)</div>
                    <div>{{checkbox (includes general.typesFormation 'FC')}} Formation Continue (FC)</div>
                </td>
            </tr>
            <tr>
                <td class="field-num">2.1.15</td>
                <td class="field-label">Total apprenants / Total formateurs</td>
                <td>Apprenants : {{general.totalApprenants}}</td>
                <td>Formateurs : {{general.totalFormateurs}}</td>
            </tr>
            <tr>
                <td class="field-num">2.1.16</td>
                <td class="field-label">Apprenants venant du 1er / 2nd cycle du secondaire</td>
                <td>1er cycle : {{general.apprenantsPremierCycle}}</td>
                <td>2nd cycle : {{general.apprenantsSecondCycle}}</td>
            </tr>
        </table>

        <h3>2.2 Autres équipements et commodités</h3>
        <table class="field-grid">
            <tr>
                <td class="field-num">2.2.1</td>
                <td class="field-label">Source d'énergie ? {{#if general.energie.disponible}}Fonctionnelle ? {{yesno
                    general.energie.fonctionnelle}}{{/if}}</td>
                <td colspan="2">
                    {{yesno general.energie.disponible}}
                    {{#if general.energie.disponible}}
                    <br>{{#each energieSourceOptions}}{{checkbox (includes ../general.energie.sources value)}} {{label}}
                    &nbsp;{{/each}}
                    {{/if}}
                </td>
            </tr>
            <tr>
                <td class="field-num">2.2.2</td>
                <td class="field-label">Source d'approvisionnement en eau ?</td>
                <td colspan="2">
                    {{yesno general.eau.disponible}}
                    {{#if general.eau.disponible}}
                    <br>{{#each eauSourceOptions}}{{checkbox (includes ../general.eau.sources value)}} {{label}}
                    &nbsp;{{/each}}
                    {{/if}}
                </td>
            </tr>
            <tr>
                <td class="field-num">2.2.3</td>
                <td class="field-label">Dispositif fonctionnel de lavage des mains ?</td>
                <td colspan="2">{{yesno general.lavageMains}}</td>
            </tr>
            <tr>
                <td class="field-num">2.2.4</td>
                <td class="field-label">A reçu une campagne de santé ?</td>
                <td colspan="2">{{yesno general.campagneSante}}</td>
            </tr>
            <tr>
                <td class="field-num">2.2.5</td>
                <td class="field-label">Boîte à pharmacie / produits de premiers soins ?</td>
                <td colspan="2">{{yesno general.boitePharmacie}}</td>
            </tr>
            <tr>
                <td class="field-num">2.2.6</td>
                <td class="field-label">Dispose d'une infirmerie ?</td>
                <td colspan="2">{{yesno general.infirmerie}}</td>
            </tr>
            <tr>
                <td class="field-num">2.2.7</td>
                <td class="field-label">Bibliothèque fonctionnelle ?</td>
                <td colspan="2">{{yesno general.bibliotheque}}</td>
            </tr>
            <tr>
                <td class="field-num">2.2.8</td>
                <td class="field-label">Le centre est-il limité par une clôture ?</td>
                <td colspan="2">
                    <div>{{checkbox (eq general.cloture 'entierement')}} Oui, entièrement</div>
                    <div>{{checkbox (eq general.cloture 'partiellement')}} Oui, partiellement</div>
                    <div>{{checkbox (eq general.cloture 'non')}} Non</div>
                </td>
            </tr>
            <tr>
