                    &nbsp;{{/each}}
                    {{/if}}
                </td>
            </tr>
            <tr>
                <td class="field-num">6.1.2</td>
                <td class="field-label">Apprenants choisissent-ils leur filière avec ce service ?</td>
                <td colspan="2">
                    {{yesno orientation.choixAvecService}}
                    {{#unless orientation.choixAvecService}}
                    <br>Collabore avec structures publiques (ex. CIOP) ? {{yesno orientation.collaborationCIOP}}
                    {{/unless}}
                </td>
            </tr>
            <tr>
                <td class="field-num">6.1.3</td>
                <td class="field-label">Accompagnement assuré aux apprenants</td>
                <td colspan="2">
                    {{#each accompagnementOptions}}{{checkbox (includes ../orientation.accompagnements value)}}
                    {{label}}<br>{{/each}}
                    {{#if orientation.accompagnementAutrePrecision}}Autres :
                    {{orientation.accompagnementAutrePrecision}}{{/if}}
                </td>
            </tr>
        </table>

        <h3>6.2 Suivi post-formation des sortants</h3>
        <table class="field-grid">
            <tr>
                <td class="field-num">6.2.1</td>
                <td class="field-label">Suivi post-formation effectué ?</td>
                <td colspan="2">
                    {{yesno orientation.suiviPostFormation.effectue}}
                    {{#if orientation.suiviPostFormation.effectue}}
                    <br>{{#each mecanismeSuiviOptions}}{{checkbox (includes ../orientation.suiviPostFormation.mecanismes
                    value)}} {{label}} &nbsp;{{/each}}
                    {{/if}}
                </td>
            </tr>
            <tr>
                <td class="field-num">6.2.2</td>
                <td class="field-label">Cellule d'appui à l'insertion des sortants ?</td>
                <td colspan="2">{{yesno orientation.celluleInsertion}}</td>
            </tr>
            <tr>
                <td class="field-num">6.2.3</td>
                <td class="field-label">Outil de gestion de la base de données des apprenants/sortants ?</td>
                <td colspan="2">{{yesno orientation.outilGestionBDD}}</td>
            </tr>
            <tr>
                <td class="field-num">6.2.4</td>
                <td class="field-label">Outil d'accompagnement recherche d'emploi / GIE / plans d'affaires ?</td>
                <td colspan="2">{{yesno orientation.outilAccompagnementEmploi}}</td>
            </tr>
        </table>

        <h3>6.3 Sortants insérés par spécialité ({{previousYearLabel}})</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th style="text-align:left;">Spécialité</th>
                    <th>Hommes</th>
                    <th>Femmes</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                {{#each orientation.sortantsInseresParSpecialite}}
                <tr>
                    <td class="rowlabel">{{specialite}}</td>
                    <td>{{hommes}}</td>
                    <td>{{femmes}}</td>
                    <td>{{total}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>

    <!-- ============================================================ -->
    <!-- SECTION 7 : THEMES TRANSVERSAUX (VIH/SIDA, IST)               -->
    <!-- ============================================================ -->
    <div class="page">
        <div class="section-title">
            <span class="fr">SECTION 7 : PRISE EN COMPTE DES THÈMES TRANSVERSAUX DANS LE PROGRAMME D'ÉDUCATION</span>
            <span class="en">SECTION 7: MAINSTREAMING CROSS-CUTTING ISSUES IN THE EDUCATION PROGRAMME</span>
        </div>

        <table class="field-grid">
            <tr>
                <td class="field-num">7.1</td>
                <td class="field-label">Règlement intérieur intègre des directives liées au VIH/SIDA ?</td>
                <td colspan="2">{{yesno transversal.reglementVIH.integre}}</td>
            </tr>
            {{#if transversal.reglementVIH.integre}}
            <tr>
                <td class="field-num">7.1.1</td>
                <td class="field-label">Ces directives couvrent-elles :</td>
                <td colspan="2">
                    <div>Sécurité physique : {{yesno transversal.reglementVIH.securitePhysique}}</div>
                    <div>Stigmatisation (personnes vivant avec le VIH) : {{yesno
                        transversal.reglementVIH.stigmatisationVIH}}</div>
                    <div>Stigmatisation (race/ethnie/religion) : {{yesno transversal.reglementVIH.stigmatisationAutre}}
                    </div>
                    <div>Harcèlement et abus sexuels : {{yesno transversal.reglementVIH.harcelement}}</div>
                </td>
            </tr>
            <tr>
                <td class="field-num">7.1.2</td>
                <td class="field-label">Procédures disciplinaires en cas de violation ?</td>
                <td colspan="2">{{yesno transversal.proceduresDisciplinaires}}</td>
            </tr>
            <tr>
                <td class="field-num">7.1.3</td>
                <td class="field-label">Parties prenantes informées</td>
                <td colspan="2">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="text-align:left;">Catégorie</th>
                                <th>Informée ?</th>
                                <th>Mode de communication</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each transversal.partiesPrenantesInformees}}
                            <tr>
                                <td class="rowlabel">{{categorie}}</td>
                                <td>{{yesno informee}}</td>
                                <td>{{modeCommunication}}</td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </td>
            </tr>
            {{/if}}
            <tr>
                <td class="field-num">7.2</td>
                <td class="field-label">Prise en compte des questions liées aux IST ?</td>
                <td colspan="2">{{yesno transversal.priseEnCompteIST}}</td>
            </tr>
            <tr>
                <td class="field-num">7.4</td>
                <td class="field-label">Éducation sexuelle et VIH axée sur les compétences pour la vie courante ?</td>
                <td colspan="2">
                    {{yesno transversal.educationSexuelleVIH.dispensee}}
                    {{#if transversal.educationSexuelleVIH.dispensee}}
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="text-align:left;">Thème</th>
                                <th>Programme officiel</th>
                                <th>Activités périscolaires</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each transversal.educationSexuelleVIH.themes}}
                            <tr>
                                <td class="rowlabel">{{theme}}</td>
                                <td>{{checkbox programmeOfficiel}}</td>
                                <td>{{checkbox activitesPeriscolaires}}</td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                    {{/if}}
                </td>
            </tr>
            <tr>
                <td class="field-num">7.5</td>
                <td class="field-label">Formateurs formés et ayant dispensé cette éducation ?</td>
                <td colspan="2">{{yesno transversal.formateursFormesEtDispensent}}</td>
            </tr>
            <tr>
                <td class="field-num">7.6</td>
                <td class="field-label">Ces formateurs ont-ils dispensé l'enseignement reçu aux élèves ?</td>
                <td colspan="2">{{yesno transversal.enseignementRetransmis}}</td>
            </tr>
            <tr>
                <td class="field-num">7.7</td>
                <td class="field-label">Sessions d'orientation organisées pour les parents/tuteurs ?</td>
                <td colspan="2">{{yesno transversal.sessionsParents}}</td>
            </tr>
        </table>
    </div>

    <!-- ============================================================ -->
    <!-- SECTION 8 : INFORMATIONS SUR LES FORMATEURS                   -->
    <!-- ============================================================ -->
    <div class="page">
        <div class="section-title">
            <span class="fr">SECTION 8 : INFORMATIONS SUR LES FORMATEURS</span>
            <span class="en">SECTION 8: DETAILS ON TRAINERS</span>
        </div>

        <h3>8.1 Formateurs par diplôme académique le plus élevé</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th style="text-align:left;">Diplôme académique</th>
                    <th>Hommes</th>
                    <th>Femmes</th>
                </tr>
            </thead>
            <tbody>
                {{#each formateurs.parDiplomeAcademique}}
                <tr>
                    <td class="rowlabel">{{label}}</td>
                    <td>{{hommes}}</td>
                    <td>{{femmes}}</td>
                </tr>
                {{/each}}
            </tbody>
            <tfoot>
                <tr>
                    <td class="rowlabel">Total</td>
                    <td>{{formateurs.parDiplomeAcademiqueTotal.hommes}}</td>
                    <td>{{formateurs.parDiplomeAcademiqueTotal.femmes}}</td>
                </tr>
            </tfoot>
        </table>

        <h3>8.2 Formateurs par diplôme professionnel le plus élevé</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th style="text-align:left;">Diplôme professionnel</th>
                    <th>Hommes</th>
                    <th>Femmes</th>
                </tr>
            </thead>
            <tbody>
                {{#each formateurs.parDiplomeProfessionnel}}
                <tr>
                    <td class="rowlabel">{{label}}</td>
                    <td>{{hommes}}</td>
                    <td>{{femmes}}</td>
                </tr>
                {{/each}}
            </tbody>
            <tfoot>
                <tr>
                    <td class="rowlabel">Total</td>
                    <td>{{formateurs.parDiplomeProfessionnelTotal.hommes}}</td>
                    <td>{{formateurs.parDiplomeProfessionnelTotal.femmes}}</td>
                </tr>
            </tfoot>
        </table>

        <h3>8.3 Formateurs par tranche d'âge</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th style="text-align:left;">Tranche d'âge</th>
                    <th>Hommes</th>
                    <th>Femmes</th>
                </tr>
            </thead>
            <tbody>
                {{#each formateurs.parTrancheAge}}
                <tr>
                    <td class="rowlabel">{{tranche}}</td>
                    <td>{{hommes}}</td>
                    <td>{{femmes}}</td>
                </tr>
                {{/each}}
            </tbody>
            <tfoot>
                <tr>
                    <td class="rowlabel">Total</td>
                    <td>{{formateurs.parTrancheAgeTotal.hommes}}</td>
                    <td>{{formateurs.parTrancheAgeTotal.femmes}}</td>
                </tr>
            </tfoot>
        </table>

        <h3>8.4 Formateurs par spécialité et type de formation</h3>
        {{#> specialtyTable rows=formateurs.parSpecialite}}{{/specialtyTable}}

        <h3>8.5 Formateurs par statut professionnel</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th style="text-align:left;">Statut</th>
                    <th>Hommes</th>
                    <th>Femmes</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                {{#each formateurs.parStatut}}
                <tr>
                    <td class="rowlabel">{{statut}}</td>
                    <td>{{hommes}}</td>
                    <td>{{femmes}}</td>
                    <td>{{total}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>

        <h3>8.6 Formateurs par type de handicap</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th style="text-align:left;">Type de handicap</th>
                    <th>Hommes</th>
                    <th>Femmes</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                {{#each formateurs.parHandicap}}
                <tr>
                    <td class="rowlabel">{{type}}</td>
                    <td>{{hommes}}</td>
                    <td>{{femmes}}</td>
                    <td>{{total}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>

        <h3>8.7 Capacité d'accueil</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th>N&deg;</th>
                    <th style="text-align:left;">Spécialité</th>
                    <th>Formation Initiale (FI)</th>
                    <th>Formation Continue (FC)</th>
                </tr>
            </thead>
            <tbody>
                {{#each formateurs.capaciteAccueil}}
                <tr>
                    <td>{{inc @index}}</td>
                    <td class="rowlabel">{{specialite}}</td>
                    <td>{{fi}}</td>
                    <td>{{fc}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>

        <h3>8.8 État nominatif du personnel formateur et administratif</h3>
        <table class="data-table" style="font-size:8px;">
            <thead>
                <tr>
                    <th>ID</th>
                    <th style="text-align:left;">Nom</th>
                    <th style="text-align:left;">Prénom</th>
                    <th>Sexe</th>
                    <th>Statut</th>
                    <th>Admin. ?</th>
                    <th>Diplôme académique</th>
                    <th>Diplôme professionnel</th>
                </tr>
            </thead>
            <tbody>
                {{#each formateurs.personnel}}
                <tr>
                    <td>{{id}}</td>
                    <td class="rowlabel">{{nom}}</td>
                    <td class="rowlabel">{{prenom}}</td>
                    <td>{{#if (eq sexe 'M')}}1{{else}}2{{/if}}</td>
                    <td>{{statutCode}}</td>
                    <td>{{#if personnelAdministratif}}1{{else}}2{{/if}}</td>
                    <td>{{diplomeAcademiqueCode}}</td>
                    <td>{{diplomeProfessionnelCode}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
        <!-- Legend text and codes verified verbatim against table 8.8 of the
             source PDF (p.18): "Sexe/Sex 1=Homme/Man 2=Femme/Woman",
             "Personnel administratif 1=oui 2=Non", the three-status
             "1=Formateurs vacataires professionnels ... 3=Formateurs
             Permanents", and the two numbered diploma lists — the source
             prints these inline inside the table's own header cells; kept
             as a footnote here instead, since a hand-column-width header
             can't hold the full numbered lists at a legible size. -->
        <p class="legend">
            <strong>Sexe :</strong> 1=Homme/Man ; 2=Femme/Woman
            &nbsp;&nbsp;|&nbsp;&nbsp;
            <strong>Personnel administratif :</strong> 1=Oui ; 2=Non
            &nbsp;&nbsp;|&nbsp;&nbsp;
            <strong>Statut :</strong>
            {{#each formateurs.legendeStatut}}{{#unless @first}}; {{/unless}}{{code}}={{label}}{{/each}}
            &nbsp;&nbsp;|&nbsp;&nbsp;
            <strong>Diplôme académique :</strong>
            {{#each formateurs.legendeDiplomeAcademique}}{{#unless @first}}; {{/unless}}{{code}}={{label}}{{/each}}
            &nbsp;&nbsp;|&nbsp;&nbsp;
            <strong>Diplôme professionnel :</strong>
            {{#each formateurs.legendeDiplomeProfessionnel}}{{#unless @first}}; {{/unless}}{{code}}={{label}}{{/each}}
        </p>
    </div>

    <!-- ============================================================ -->
    <!-- SECTION 9 : DIFFICULTES ET PERSPECTIVES + SIGNATURES          -->
    <!-- ============================================================ -->
    <div class="page">
        <div class="section-title">
            <span class="fr">SECTION 9 : DIFFICULTÉS ET PERSPECTIVES</span>
            <span class="en">SECTION 9: DIFFICULTIES AND PROSPECTS</span>
        </div>

        <table class="field-grid">
            <tr>
                <td class="field-num">9.1</td>
                <td class="field-label">Rencontrez-vous des difficultés dans le processus de formation ?</td>
                <td colspan="2">{{yesno difficultes.rencontrees}}</td>
            </tr>
            {{#if difficultes.rencontrees}}
            <tr>
                <td></td>
                <td class="field-label">Lesquelles</td>
                <td colspan="2">
                    {{#each difficulteOptions}}{{checkbox (includes ../difficultes.types value)}} {{label}}<br>{{/each}}
                    {{#each difficultes.autresPrecisions}}
                    <div>Autre : {{this}}</div>
                    {{/each}}
                </td>
            </tr>
            {{/if}}
        </table>

        <h3>9.2 Cinq principales perspectives</h3>
        <ol>
            {{#each difficultes.perspectives}}
            <li>{{this}}</li>
            {{/each}}
        </ol>

        <p style="margin-top:20px;"><span class="fr">Merci pour votre collaboration</span><span class="en">Thank you for your collaboration</span></p>

        <div class="signature-row">
            <table>
                <tr>
                    <td>Nom, signature et cachet du directeur ou Promoteur du
                        CFP<br>{{identification.promoteur.nomPrenoms}}</td>
                    <td>Nom, signature et cachet du Délégué Départemental ou Régional</td>
                    <td>Nom, signature et cachet du Secrétaire Technique Régional de l'ONEFOP</td>
                </tr>
            </table>
        </div>
    </div>

</body>

</html>