{{! ONEFOP — Questionnaire Entreprise — Mapper-aligned, PDF-matched v2 }}
{{! REQUIRED HANDLEBARS HELPERS: eq, formatCell }}
{{#with this}}
<!DOCTYPE html>
<html lang="{{lang}}">

<head>
  <meta charset="utf-8" />
  <title>ONEFOP Entreprise {{surveyYear}}</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0
    }

    body {
      font-family: "Arial Narrow", Arial, Helvetica, sans-serif;
      font-size: 9pt;
      color: #000;
      background: #fff;
      line-height: 1.3
    }

    .page {
      width: 210mm;
      min-height: 297mm;
      padding: 5mm 7mm;
      page-break-after: always;
      position: relative
    }

    .page:last-child {
      page-break-after: auto
    }

    .hdr {
      margin-bottom: 3mm;
      font-size: 8pt
    }

    .hdr-top {
      display: flex;
      align-items: flex-start;
      min-height: 24mm
    }

    .hdr-fr {
      width: 37%;
      padding: 1mm 2mm;
      text-align: center;
      font-size: 7.5pt;
      line-height: 1.45
    }

    .hdr-logo-c {
      width: 26%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      padding: 0 2mm
    }

    .hdr-logo-c img {
      max-width: 100%;
      max-height: 16mm;
      display: block;
      margin: 0 auto
    }

    .hdr-logo-c .ltag {
      font-size: 5.5pt;
      font-weight: bold;
      text-align: center;
      line-height: 1.2;
      text-transform: uppercase;
      margin-top: 1mm
    }

    .hdr-en {
      width: 37%;
      padding: 1mm 2mm;
      text-align: center;
      font-size: 7.5pt;
      line-height: 1.45
    }

    .hdr-fr .co,
    .hdr-en .co {
      font-weight: bold;
      font-size: 7.5pt
    }

    .sep {
      font-size: 6.5pt;
      color: #444
    }

    .hdr-bar {
      background: #1F3864;
      padding: 2.5mm 4mm;
      text-align: center
    }

    .hdr-bar .t1 {
      font-weight: bold;
      font-size: 9pt;
      color: #fff;
      text-transform: uppercase;
      line-height: 1.35
    }

    .hdr-bar .t2 {
      font-size: 7.5pt;
      color: #fff;
      font-style: italic;
      margin-top: 0.8mm
    }

    .conf {
      border: 1.5px solid #000;
      padding: 2mm 3mm;
      margin-bottom: 2.5mm;
      font-size: 7.5pt;
      line-height: 1.35
    }

    .sec {
      background: #5B9BD5;
      color: #fff;
      font-weight: bold;
      font-size: 9.5pt;
      padding: 2px 5px;
      margin: 2.5mm 0 1.5mm;
      text-transform: uppercase
    }

    .subsec {
      background: #BDD7EE;
      color: #000;
      font-weight: bold;
      font-style: italic;
      font-size: 8.5pt;
      padding: 2px 5px;
      margin: 2mm 0 1.5mm
    }

    .qt {
      background: #FFF2CC;
      border: 1px solid #000;
      padding: 2px 4px;
      margin: 1.5mm 0 0;
      font-size: 7.5pt;
      line-height: 1.35
    }

    .ftable {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 1mm;
      font-size: 8pt
    }

    .ftable td {
      border: 1px solid #000;
      padding: 2px 3px;
      background: #fff;
      vertical-align: middle;
      font-size: 8pt;
      text-align: left
    }

    .ftable td.fc {
      font-weight: bold;
      width: 11mm;
      white-space: nowrap
    }

    .ph-box {
      display: inline-flex;
      gap: 0;
      vertical-align: middle
    }

    .ph-box .pd {
      display: inline-block;
      width: 5mm;
      height: 4.5mm;
      border: 1px solid #000;
      border-right: none;
      font-size: 7pt;
      text-align: center;
      line-height: 4.5mm;
      font-family: monospace;
      background: #fff
    }

    .ph-box .pd:last-child {
      border-right: 1px solid #000
    }

    .cb {
      display: inline-flex;
      gap: 0;
      vertical-align: middle
    }

    .cb span {
      display: inline-block;
      width: 5mm;
      height: 4.5mm;
      border: 1px solid #000;
      border-right: none;
      font-size: 7.5pt;
      text-align: center;
      line-height: 4.5mm
    }

    .cb span:last-child {
      border-right: 1px solid #000
    }

    .radio-opt {
      font-size: 8pt;
      white-space: nowrap
    }

    table.dt {
      width: 100%;
      border-collapse: collapse;
      margin: 0 0 1.5mm;
      font-size: 7pt
    }

    table.dt th {
      background: #BFBFBF;
      color: #000;
      text-align: center;
      padding: 2px 1px;
      border: 1px solid #000;
      font-size: 7.5pt;
      font-weight: bold;
      line-height: 1.15
    }

    table.dt th.g {
      background: #BFBFBF;
      color: #000
    }

    table.dt th.r {
      background: #D0CECE;
      color: #000
    }

    table.dt td {
      background: #fff;
      border: 1px solid #000;
      text-align: center;
      padding: 1px 1px;
      font-size: 7.5pt;
      height: 5mm;
      vertical-align: middle
    }

    table.dt td.lb {
      background: #DEEAF6;
      text-align: left;
      font-size: 7.5pt;
      padding-left: 3px;
      height: 5mm
    }

    table.dt td.tot-col {
      background: #DEEAF6
    }

    table.dt tr.tot td {
      background: #DEEAF6;
      font-weight: bold
    }

    table.dt tr.tot td.lb {
      background: #DEEAF6;
      font-weight: bold
    }

    table.dt tr {
      page-break-inside: avoid;
    }

    table.dt tr.csp-hdr th,
    table.dt tr.csp-hdr td {
      background: #1F3864;
      color: #fff;
      font-weight: bold;
      text-align: left;
      padding: 2.5px 5px;
      font-size: 7.5pt;
      page-break-after: avoid;
    }

    table.dt tr.subtotal td {
      background: #EBF1F5;
      font-weight: bold;
      border-top: 1.5px solid #1F3864;
    }

    table.dt tr.grand-tot td {
      background: #BFBFBF;
      font-weight: bold;
      border-top: 2px solid #000;
    }

    table.dt tr.grand-tot td.tot-col {
      background: #B4C6E7;
      font-weight: bold;
    }

    .bl {
      display: inline-block;
      border-bottom: 1px solid #000;
      min-width: 55mm;
      vertical-align: bottom
    }

    @media print {
      body {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact
      }
    }
  </style>
  <base target="_blank">
</head>

<body>

  {{! ══ PARTIALS ════════════════════════════════════════════════════════ }}

  {{! CSP × Age × Gender partial }}
  {{#*inline "cspAgeTable"}}
  <table class="dt">
    <thead>
      <tr>
        <th style="width:16%;background:#BFBFBF;color:#000">{{t "common.table.sex"}}</th>
        <th colspan="4">{{t "common.table.male"}}</th>
        <th colspan="4">{{t "common.table.female"}}</th>
        <th colspan="4">{{t "common.table.total"}}</th>
      </tr>
      <tr>
        <th class="g">{{t "common.table.age_group"}}</th>
        <th class="g">{{t "common.table.age_15_24"}}</th>
        <th class="g">{{t "common.table.age_25_34"}}</th>
        <th class="g">{{t "common.table.age_35_plus"}}</th>
        <th class="g">{{t "common.table.total"}}</th>
        <th class="g">{{t "common.table.age_15_24"}}</th>
        <th class="g">{{t "common.table.age_25_34"}}</th>
        <th class="g">{{t "common.table.age_35_plus"}}</th>
        <th class="g">{{t "common.table.total"}}</th>
        <th class="g">{{t "common.table.age_15_24"}}</th>
        <th class="g">{{t "common.table.age_25_34"}}</th>
        <th class="g">{{t "common.table.age_35_plus"}}</th>
        <th class="g">{{t "common.table.total"}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each rows}}
      <tr>
        <td class="lb">{{label}}</td>
        <td>{{{formatCell male.age15_24}}}</td>
        <td>{{{formatCell male.age25_34}}}</td>
        <td>{{{formatCell male.age35plus}}}</td>
        <td class="tot-col">{{{formatCell male.total}}}</td>
        <td>{{{formatCell female.age15_24}}}</td>
        <td>{{{formatCell female.age25_34}}}</td>
        <td>{{{formatCell female.age35plus}}}</td>
        <td class="tot-col">{{{formatCell female.total}}}</td>
        <td>{{{formatCell this.total.age15_24}}}</td>
        <td>{{{formatCell this.total.age25_34}}}</td>
        <td>{{{formatCell this.total.age35plus}}}</td>
        <td class="tot-col">{{{formatCell this.total.total}}}</td>
      </tr>
      {{/each}}
      {{#if totals}}
      <tr class="tot">
        <td class="lb">{{totals.label}}</td>
        <td>{{{formatCell totals.male.age15_24}}}</td>
        <td>{{{formatCell totals.male.age25_34}}}</td>
        <td>{{{formatCell totals.male.age35plus}}}</td>
        <td class="tot-col">{{{formatCell totals.male.total}}}</td>
        <td>{{{formatCell totals.female.age15_24}}}</td>
        <td>{{{formatCell totals.female.age25_34}}}</td>
        <td>{{{formatCell totals.female.age35plus}}}</td>
        <td class="tot-col">{{{formatCell totals.female.total}}}</td>
        <td>{{{formatCell totals.total.age15_24}}}</td>
        <td>{{{formatCell totals.total.age25_34}}}</td>
        <td>{{{formatCell totals.total.age35plus}}}</td>
        <td class="tot-col">{{{formatCell totals.total.total}}}</td>
      </tr>
      {{/if}}
    </tbody>
  </table>
  {{/inline}}

  {{! CSP-Grouped Diploma Table partial (Option A for S22Q03) }}
  {{#*inline "cspGroupedDiplomaTable"}}
  <table class="dt">
    <thead>
      <tr>
        <th style="width:22%;background:#BFBFBF;color:#000">{{t "common.table.diploma"}}</th>
        <th colspan="4">{{t "common.table.male"}}</th>
        <th colspan="4">{{t "common.table.female"}}</th>
        <th colspan="4">{{t "common.table.total"}}</th>
      </tr>
      <tr>
        <th class="g">{{t "common.table.age_group"}}</th>
        <th class="g">{{t "common.table.age_15_24"}}</th>
        <th class="g">{{t "common.table.age_25_34"}}</th>
        <th class="g">{{t "common.table.age_35_plus"}}</th>
        <th class="g">{{t "common.table.total"}}</th>
        <th class="g">{{t "common.table.age_15_24"}}</th>
        <th class="g">{{t "common.table.age_25_34"}}</th>
        <th class="g">{{t "common.table.age_35_plus"}}</th>
        <th class="g">{{t "common.table.total"}}</th>
        <th class="g">{{t "common.table.age_15_24"}}</th>
        <th class="g">{{t "common.table.age_25_34"}}</th>
        <th class="g">{{t "common.table.age_35_plus"}}</th>
        <th class="g">{{t "common.table.total"}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each groups}}
      <tr class="csp-hdr">
        <td colspan="13">&#9654; {{label}}</td>
      </tr>
      {{#each rows}}
      <tr>
        <td class="lb" style="padding-left:6px;">{{label}}</td>
        <td>{{{formatCell male.age15_24}}}</td>
        <td>{{{formatCell male.age25_34}}}</td>
        <td>{{{formatCell male.age35plus}}}</td>
        <td class="tot-col">{{{formatCell male.total}}}</td>
        <td>{{{formatCell female.age15_24}}}</td>
        <td>{{{formatCell female.age25_34}}}</td>
        <td>{{{formatCell female.age35plus}}}</td>
        <td class="tot-col">{{{formatCell female.total}}}</td>
        <td>{{{formatCell this.total.age15_24}}}</td>
        <td>{{{formatCell this.total.age25_34}}}</td>
        <td>{{{formatCell this.total.age35plus}}}</td>
        <td class="tot-col">{{{formatCell this.total.total}}}</td>
      </tr>
      {{/each}}
      <tr class="tot subtotal">
        <td class="lb">{{totals.label}}</td>
        <td>{{{formatCell totals.male.age15_24}}}</td>
        <td>{{{formatCell totals.male.age25_34}}}</td>
        <td>{{{formatCell totals.male.age35plus}}}</td>
        <td class="tot-col">{{{formatCell totals.male.total}}}</td>
        <td>{{{formatCell totals.female.age15_24}}}</td>
        <td>{{{formatCell totals.female.age25_34}}}</td>
        <td>{{{formatCell totals.female.age35plus}}}</td>
        <td class="tot-col">{{{formatCell totals.female.total}}}</td>
        <td>{{{formatCell totals.total.age15_24}}}</td>
        <td>{{{formatCell totals.total.age25_34}}}</td>
        <td>{{{formatCell totals.total.age35plus}}}</td>
        <td class="tot-col">{{{formatCell totals.total.total}}}</td>
      </tr>
      {{/each}}
      {{#if grandTotals}}
      <tr class="tot grand-tot">
        <td class="lb">{{grandTotals.label}}</td>
        <td>{{{formatCell grandTotals.male.age15_24}}}</td>
        <td>{{{formatCell grandTotals.male.age25_34}}}</td>
        <td>{{{formatCell grandTotals.male.age35plus}}}</td>
        <td class="tot-col">{{{formatCell grandTotals.male.total}}}</td>
        <td>{{{formatCell grandTotals.female.age15_24}}}</td>
        <td>{{{formatCell grandTotals.female.age25_34}}}</td>
        <td>{{{formatCell grandTotals.female.age35plus}}}</td>
        <td class="tot-col">{{{formatCell grandTotals.female.total}}}</td>
        <td>{{{formatCell grandTotals.total.age15_24}}}</td>
        <td>{{{formatCell grandTotals.total.age25_34}}}</td>
        <td>{{{formatCell grandTotals.total.age35plus}}}</td>
        <td class="tot-col">{{{formatCell grandTotals.total.total}}}</td>
      </tr>
      {{/if}}
    </tbody>
  </table>
  {{/inline}}

  {{! Perm/Temp × CSP partial }}
  {{#*inline "permTempTable"}}
  <table class="dt">
    <thead>
      <tr>
        <th rowspan="2" style="width:28%;background:#D0CECE;color:#000">{{#if headerLabel}}{{{headerLabel}}}{{else}}{{t "common.table.csp"}}{{/if}}</th>
        <th class="r" colspan="3">{{t "common.table.permanent"}}</th>
        <th class="r" colspan="3">{{t "common.table.temporary"}}</th>
        <th class="r">{{t "common.table.total"}}</th>
      </tr>
      <tr>
        <th class="r">{{t "common.table.m"}}</th>
        <th class="r">{{t "common.table.f"}}</th>
        <th class="r">{{t "common.table.t"}}</th>
        <th class="r">{{t "common.table.m"}}</th>
        <th class="r">{{t "common.table.f"}}</th>
        <th class="r">{{t "common.table.t"}}</th>
        <th class="r">&nbsp;</th>
      </tr>
    </thead>
    <tbody>
      {{#each rows}}
      <tr>
        <td class="lb">{{label}}</td>
        <td>{{{formatCell permanent.male}}}</td>
        <td>{{{formatCell permanent.female}}}</td>
        <td class="tot-col">{{{formatCell permanent.total}}}</td>
        <td>{{{formatCell temporary.male}}}</td>
        <td>{{{formatCell temporary.female}}}</td>
        <td class="tot-col">{{{formatCell temporary.total}}}</td>
        <td class="tot-col">{{{formatCell this.total.total}}}</td>
      </tr>
      {{/each}}
      {{#if totals}}
      <tr class="tot">
        <td class="lb">{{totals.label}}</td>
        <td>{{{formatCell totals.permanent.male}}}</td>
        <td>{{{formatCell totals.permanent.female}}}</td>
        <td class="tot-col">{{{formatCell totals.permanent.total}}}</td>
        <td>{{{formatCell totals.temporary.male}}}</td>
        <td>{{{formatCell totals.temporary.female}}}</td>
        <td class="tot-col">{{{formatCell totals.temporary.total}}}</td>
        <td class="tot-col">{{{formatCell totals.total.total}}}</td>
      </tr>
      {{/if}}
    </tbody>
  </table>
  {{/inline}}

  {{! ══ PAGE 1: Header + S0 + S1 ══════════════════════════════════════ }}
  <div class="page">

    <div class="hdr">
      {{> letterhead}}
      <div class="hdr-bar">
        <div class="t1">{{t "common.survey_title"}}</div>
        <div class="t2">{{t "enterprise.subtitle"}}</div>
        <div style="font-size:6.5pt;color:#D9E1F2;margin-top:1.2mm;letter-spacing:0.3px;">{{#if officialBannerText}}{{officialBannerText}}{{else}}Formulaire officiel ONEFOP &middot; Document g&eacute;n&eacute;r&eacute; via la plateforme CAM-LEAP{{/if}}</div>
      </div>
    </div>

    <div class="conf">
      <strong>{{t "common.confidentiality"}}</strong>
    </div>

    <div class="sec">{{t "enterprise.sec0_title"}}</div>

    <table class="ftable">
      <tr>
        <td class="fc">S0Q01</td>
        <td>{{t "common.s0.name"}} {{respondentName}}</td>
      </tr>
      <tr>
        <td class="fc">S0Q02</td>
        <td>{{t "common.s0.function"}} {{respondentFunction}}</td>
      </tr>
      <tr>
        <td class="fc" style="vertical-align:top">S0Q03</td>
        <td>
          {{t "common.s0.contacts"}} {{t "common.s0.tel1"}} {{phoneBoxes respondentPhone1 9}} &nbsp; {{t "common.s0.tel2"}} {{phoneBoxes respondentPhone2 9}}<br />{{t "common.s0.email"}} {{respondentEmail}}
        </td>
      </tr>
    </table>

    <div class="sec">{{t "enterprise.sec1_title"}}</div>

    <table class="ftable">
      <tr>
        <td class="fc">S1Q01</td>
        <td>{{t "enterprise.s1q01"}}<br />
          <span class="radio-opt">{{#if (eq legalStatus 1)}}&#9745;{{else}}&#9744;{{/if}} {{t "enterprise.s1q01_1"}}</span> &nbsp;
          <span class="radio-opt">{{#if (eq legalStatus 2)}}&#9745;{{else}}&#9744;{{/if}} {{t "enterprise.s1q01_2"}}</span> &nbsp;
          <span class="radio-opt">{{#if (eq legalStatus 3)}}&#9745;{{else}}&#9744;{{/if}} {{t "enterprise.s1q01_3"}}</span> &nbsp;
          <span class="radio-opt">{{#if (eq legalStatus 4)}}&#9745;{{else}}&#9744;{{/if}} {{t "enterprise.s1q01_4"}}</span>
        </td>
      </tr>
      <tr>
        <td class="fc">S1Q02</td>
        <td>{{t "enterprise.s1q02"}} {{companyName}}</td>
      </tr>
      <tr>
        <td class="fc">S1Q03</td>
        <td>{{t "enterprise.s1q03"}} &nbsp;
          <span class="radio-opt">{{#if (eq area 1)}}&#9745;{{else}}&#9744;{{/if}} {{t "enterprise.s1q03_1"}}</span> &nbsp;
          <span class="radio-opt">{{#if (eq area 2)}}&#9745;{{else}}&#9744;{{/if}} {{t "enterprise.s1q03_2"}}</span>
        </td>
      </tr>
      <tr>
        <td class="fc">S1Q04</td>
        <td>{{t "enterprise.s1q04_region"}} {{region}} &nbsp; {{t "enterprise.s1q04_dept"}} {{department}}<br />
          {{t "enterprise.s1q04_subdiv"}} {{subdivision}} &nbsp; {{t "enterprise.s1q04_locality"}} {{locality}}
        </td>
      </tr>
      <tr>
        <td class="fc">S1Q05</td>
        <td>{{t "enterprise.s1q05_tel1"}} {{phoneBoxes phone1 9}} &nbsp; {{t "enterprise.s1q05_tel2"}} {{phoneBoxes phone2 9}} &nbsp; {{t "enterprise.s1q05_bp"}} {{poBox}}
        </td>
      </tr>
      <tr>
        <td class="fc">S1Q06</td>
        <td>{{t "enterprise.s1q06"}} &nbsp;
          <span class="radio-opt">{{#if (eq businessSector 1)}}&#9745;{{else}}&#9744;{{/if}} {{t "enterprise.s1q06_1"}}</span> &nbsp;
          <span class="radio-opt">{{#if (eq businessSector 2)}}&#9745;{{else}}&#9744;{{/if}} {{t "enterprise.s1q06_2"}}</span> &nbsp;
          <span class="radio-opt">{{#if (eq businessSector 3)}}&#9745;{{else}}&#9744;{{/if}} {{t "enterprise.s1q06_3"}}</span>
        </td>
      </tr>
      <tr>
        <td class="fc">S1Q07</td>
        <td>{{t "enterprise.s1q07"}} {{branchActivity}}</td>
      </tr>
      <tr>
        <td class="fc">S1Q08</td>
        <td>{{t "enterprise.s1q08"}} {{mainActivity}}</td>
      </tr>
      <tr>
        <td class="fc">S1Q09</td>
        <td>{{t "enterprise.s1q09"}} {{headOffice}}</td>
      </tr>
      <tr>
        <td class="fc">S1Q10</td>
        <td>{{t "enterprise.s1q10"}} {{permanentWorkers}}</td>
      </tr>
      <tr>
        <td class="fc">S1Q11</td>
        <td>{{t "enterprise.s1q11"}} {{vacancies}}</td>
      </tr>
      <tr>
        <td class="fc">S1Q12</td>
        <td>{{t "enterprise.s1q12"}} &nbsp;
          <span class="radio-opt">{{#if (eq enterpriseSize 1)}}&#9745;{{else}}&#9744;{{/if}} {{t "enterprise.size_1"}}</span> &nbsp;
          <span class="radio-opt">{{#if (eq enterpriseSize 2)}}&#9745;{{else}}&#9744;{{/if}} {{t "enterprise.size_2"}}</span> &nbsp;
          <span class="radio-opt">{{#if (eq enterpriseSize 3)}}&#9745;{{else}}&#9744;{{/if}} {{t "enterprise.size_3"}}</span> &nbsp;
          <span class="radio-opt">{{#if (eq enterpriseSize 4)}}&#9745;{{else}}&#9744;{{/if}} {{t "enterprise.size_4"}}</span>
        </td>
      </tr>
    </table>

    <div class="sec">{{t "common.s2.sec2_title"}}</div>
    <div class="subsec">{{t "common.s2.s21_sec"}}</div>

    <div class="qt">{{t "common.s2.s21q01" collectionPeriod=collectionPeriod}}</div>
    {{> cspAgeTable rows=jobApplicationsRows totals=jobApplicationsTotals}}

  </div>

  {{! ══ PAGE 2: S22Q01 + S22Q02 + S22Q03 ════════════════════════════════ }}
  <div class="page">

    <div class="subsec">{{t "common.s2.s22_sec"}}</div>

    <div class="qt">{{t "common.s2.s22q01" collectionPeriod=collectionPeriod}}</div>
    {{> cspAgeTable rows=recruitmentsPermanentRows totals=recruitmentsPermanentTotals}}

