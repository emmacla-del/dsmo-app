{{! ONEFOP — Questionnaire Administration — Phase 1 v1 (derived from ONG v1) }}
{{! CHANGES: S1 = ADMIN_S1Q01-Q12 (incl. 2 conditional Oui/Non branches, not
    rendered as checkboxes for simplicity — shown as plain Oui/Non + count).
    Section 2.2 collapses permanent/temporary into one SFP-row table
    (recruitmentsPermanentRows/Totals); no diploma table, no "Primo
    demandeur" (2.3), no S3Q03, no S4Q03 — see the Phase 1 audit for why.
    Section 2 is numbered chronologically S21Q01–S21Q04 (decision of
    2026-09-28): S21Q01 census, S21Q02 recruitment, S21Q03 disability
    (catégorie × sexe), S21Q04 vulnerable (nature × sexe). S21Q03/S21Q04
    have no permanent/temporary status → the "sexTable" partial. }}
{{#with this}}
<!DOCTYPE html>
<html lang="{{lang}}">

<head>
  <meta charset="utf-8" />
  <title>ONEFOP Administration {{surveyYear}}</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0
    }

    body {
      font-family: "Arial Narrow", Arial, Helvetica, sans-serif;
      font-size: 9pt;
      color: #000;
      background: #fff;
      line-height: 1.3
    }

    .page {
      width: 210mm;
      min-height: 297mm;
      padding: 5mm 7mm;
      page-break-after: always;
      position: relative
    }

    .page:last-child {
      page-break-after: auto
    }

    .hdr {
      margin-bottom: 3mm;
      font-size: 8pt
    }

    .hdr-top {
      display: flex;
      align-items: flex-start;
      min-height: 24mm
    }

    .hdr-fr {
      width: 37%;
      padding: 1mm 2mm;
      text-align: center;
      font-size: 7.5pt;
      line-height: 1.45
    }

    .hdr-logo-c {
      width: 26%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      padding: 0 2mm
    }

    .hdr-logo-c img {
      max-width: 100%;
      max-height: 16mm;
      display: block;
      margin: 0 auto
    }

    .hdr-logo-c .ltag {
      font-size: 5.5pt;
      font-weight: bold;
      text-align: center;
      line-height: 1.2;
      text-transform: uppercase;
      margin-top: 1mm
    }

    .hdr-en {
      width: 37%;
      padding: 1mm 2mm;
      text-align: center;
      font-size: 7.5pt;
      line-height: 1.45
    }

    .hdr-fr .co,
    .hdr-en .co {
      font-weight: bold;
      font-size: 7.5pt
    }

    .sep {
      font-size: 6.5pt;
      color: #444
    }

    .hdr-bar {
      background: #1F3864;
      padding: 2.5mm 4mm;
      text-align: center
    }

    .hdr-bar .t1 {
      font-weight: bold;
      font-size: 9pt;
      color: #fff;
      text-transform: uppercase;
      line-height: 1.35
    }

    .hdr-bar .t2 {
      font-size: 7.5pt;
      color: #fff;
      font-style: italic;
      margin-top: 0.8mm
    }

    .conf {
      border: 1.5px solid #000;
      padding: 2mm 3mm;
      margin-bottom: 2.5mm;
      font-size: 7.5pt;
      line-height: 1.35
    }

    .sec {
      background: #5B9BD5;
      color: #fff;
      font-weight: bold;
      font-size: 9.5pt;
      padding: 2px 5px;
      margin: 2.5mm 0 1.5mm;
      text-transform: uppercase
    }

    .sec-s1 {
      background: #BDD7EE;
      color: #000;
      font-weight: bold;
      font-style: italic;
      font-size: 9.5pt;
      padding: 2px 5px;
      margin: 2.5mm 0 1.5mm
    }

    .subsec {
      background: #BDD7EE;
      color: #000;
      font-weight: bold;
      font-style: italic;
      font-size: 8.5pt;
      padding: 2px 5px;
      margin: 2mm 0 1.5mm
    }

    .qt {
      background: #FFF2CC;
      border: 1px solid #000;
      padding: 2px 4px;
      margin: 1.5mm 0 0;
      font-size: 7.5pt;
      line-height: 1.35
    }

    .ftable {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 1mm;
      font-size: 8pt
    }

    .ftable td {
      border: 1px solid #000;
      padding: 2px 3px;
      background: #fff;
      vertical-align: middle;
      font-size: 8pt;
      text-align: left
    }

    .ftable td.fc {
      font-weight: bold;
      width: 11mm;
      white-space: nowrap
    }

    .ph-box {
      display: inline-flex;
      gap: 0;
      vertical-align: middle
    }

    .ph-box .pd {
      display: inline-block;
      width: 5mm;
      height: 4.5mm;
      border: 1px solid #000;
      border-right: none;
      font-size: 7pt;
      text-align: center;
      line-height: 4.5mm;
      font-family: monospace;
      background: #fff
    }

    .ph-box .pd:last-child {
      border-right: 1px solid #000
    }

    .cb {
      display: inline-flex;
      gap: 0;
      vertical-align: middle
    }

    .cb span {
      display: inline-block;
      width: 5mm;
      height: 4.5mm;
      border: 1px solid #000;
      border-right: none;
      font-size: 7.5pt;
      text-align: center;
      line-height: 4.5mm
    }

    .cb span:last-child {
      border-right: 1px solid #000
    }

    .radio-opt {
      font-size: 8pt;
      white-space: nowrap
    }

    table.dt {
      width: 100%;
      border-collapse: collapse;
      margin: 0 0 1.5mm;
      font-size: 7pt
    }

    table.dt th {
      background: #BFBFBF;
      color: #000;
      text-align: center;
      padding: 2px 1px;
      border: 1px solid #000;
      font-size: 7.5pt;
      font-weight: bold;
      line-height: 1.15
    }

    table.dt th.g {
      background: #BFBFBF;
      color: #000
    }

    table.dt th.r {
      background: #D0CECE;
      color: #000
    }

    table.dt td {
      background: #fff;
      border: 1px solid #000;
      text-align: center;
      padding: 1px 1px;
      font-size: 7.5pt;
      height: 5mm;
      vertical-align: middle
    }

    table.dt td.lb {
      background: #DEEAF6;
      text-align: left;
      font-size: 7.5pt;
      padding-left: 3px;
      height: 5mm
    }

    table.dt td.tot-col {
      background: #DEEAF6
    }

    table.dt tr.tot td {
      background: #DEEAF6;
      font-weight: bold
    }

    table.dt tr.tot td.lb {
      background: #DEEAF6;
      font-weight: bold
    }

    .bl {
      display: inline-block;
      border-bottom: 1px solid #000;
      min-width: 55mm;
      vertical-align: bottom
    }

    @media print {
      body {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact
      }
    }
  </style>
</head>

<body>

  {{! ══ PARTIALS ════════════════════════════════════════════════════════ }}

  {{#*inline "cspAgeTable"}}
  <table class="dt">
    <thead>
      <tr>
        <th style="width:16%;background:#BFBFBF;color:#000">{{t "common.table.sex"}}</th>
        <th colspan="4">{{t "common.table.male"}}</th>
        <th colspan="4">{{t "common.table.female"}}</th>
        <th colspan="4">{{t "common.table.total"}}</th>
      </tr>
      <tr>
        <th class="g">{{t "common.table.age_group"}}</th>
        <th class="g">{{t "common.table.age_15_24"}}</th>
        <th class="g">{{t "common.table.age_25_34"}}</th>
        <th class="g">{{t "common.table.age_35_plus"}}</th>
        <th class="g">Total</th>
        <th class="g">{{t "common.table.age_15_24"}}</th>
        <th class="g">{{t "common.table.age_25_34"}}</th>
        <th class="g">{{t "common.table.age_35_plus"}}</th>
        <th class="g">Total</th>
        <th class="g">{{t "common.table.age_15_24"}}</th>
        <th class="g">{{t "common.table.age_25_34"}}</th>
        <th class="g">{{t "common.table.age_35_plus"}}</th>
        <th class="g">Total</th>
      </tr>
    </thead>
    <tbody>
      {{#each rows}}
      <tr>
        <td class="lb">{{label}}</td>
        <td>{{{formatCell male.age15_24}}}</td>
        <td>{{{formatCell male.age25_34}}}</td>
        <td>{{{formatCell male.age35plus}}}</td>
        <td class="tot-col">{{{formatCell male.total}}}</td>
        <td>{{{formatCell female.age15_24}}}</td>
        <td>{{{formatCell female.age25_34}}}</td>
        <td>{{{formatCell female.age35plus}}}</td>
        <td class="tot-col">{{{formatCell female.total}}}</td>
        <td>{{{formatCell this.total.age15_24}}}</td>
        <td>{{{formatCell this.total.age25_34}}}</td>
        <td>{{{formatCell this.total.age35plus}}}</td>
        <td class="tot-col">{{{formatCell this.total.total}}}</td>
      </tr>
      {{/each}}
      {{#if totals}}
      <tr class="tot">
        <td class="lb">{{totals.label}}</td>
        <td>{{{formatCell totals.male.age15_24}}}</td>
        <td>{{{formatCell totals.male.age25_34}}}</td>
        <td>{{{formatCell totals.male.age35plus}}}</td>
        <td class="tot-col">{{{formatCell totals.male.total}}}</td>
        <td>{{{formatCell totals.female.age15_24}}}</td>
        <td>{{{formatCell totals.female.age25_34}}}</td>
        <td>{{{formatCell totals.female.age35plus}}}</td>
        <td class="tot-col">{{{formatCell totals.female.total}}}</td>
        <td>{{{formatCell totals.total.age15_24}}}</td>
        <td>{{{formatCell totals.total.age25_34}}}</td>
        <td>{{{formatCell totals.total.age35plus}}}</td>
        <td class="tot-col">{{{formatCell totals.total.total}}}</td>
      </tr>
      {{/if}}
    </tbody>
  </table>
  {{/inline}}

  {{#*inline "permTempTable"}}
  <table class="dt">
    <thead>
      <tr>
        <th rowspan="2" style="width:28%;background:#D0CECE;color:#000">{{#if headerLabel}}{{{headerLabel}}}{{else}}{{t "common.table.csp"}}{{/if}}</th>
        <th class="r" colspan="3">{{t "common.table.permanent"}}</th>
        <th class="r" colspan="3">{{t "common.table.temporary"}}</th>
        <th class="r">{{t "common.table.total"}}</th>
      </tr>
      <tr>
        <th class="r">{{t "common.table.m"}}</th>
        <th class="r">{{t "common.table.f"}}</th>
        <th class="r">{{t "common.table.t"}}</th>
        <th class="r">{{t "common.table.m"}}</th>
        <th class="r">{{t "common.table.f"}}</th>
        <th class="r">{{t "common.table.t"}}</th>
        <th class="r">&nbsp;</th>
      </tr>
    </thead>
    <tbody>
      {{#each rows}}
      <tr>
        <td class="lb">{{label}}</td>
        <td>{{{formatCell permanent.male}}}</td>
        <td>{{{formatCell permanent.female}}}</td>
        <td class="tot-col">{{{formatCell permanent.total}}}</td>
        <td>{{{formatCell temporary.male}}}</td>
        <td>{{{formatCell temporary.female}}}</td>
        <td class="tot-col">{{{formatCell temporary.total}}}</td>
        <td class="tot-col">{{{formatCell this.total.total}}}</td>
      </tr>
      {{/each}}
      {{#if totals}}
      <tr class="tot">
        <td class="lb">{{totals.label}}</td>
        <td>{{{formatCell totals.permanent.male}}}</td>
        <td>{{{formatCell totals.permanent.female}}}</td>
        <td class="tot-col">{{{formatCell totals.permanent.total}}}</td>
        <td>{{{formatCell totals.temporary.male}}}</td>
        <td>{{{formatCell totals.temporary.female}}}</td>
        <td class="tot-col">{{{formatCell totals.temporary.total}}}</td>
        <td class="tot-col">{{{formatCell totals.total.total}}}</td>
      </tr>
      {{/if}}
    </tbody>
  </table>
  {{/inline}}

  {{! Category/nature rows × sex (M/F/T) — tables without a status dimension. }}
  {{#*inline "sexTable"}}
  <table class="dt">
    <thead>
      <tr>
        <th style="width:40%;background:#D0CECE;color:#000">{{{headerLabel}}}</th>
        <th class="r">{{t "common.table.m"}}</th>
        <th class="r">{{t "common.table.f"}}</th>
        <th class="r">{{t "common.table.t"}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each rows}}
      <tr>
        <td class="lb">{{label}}</td>
        <td>{{{formatCell this.total.male}}}</td>
        <td>{{{formatCell this.total.female}}}</td>
        <td class="tot-col">{{{formatCell this.total.total}}}</td>
      </tr>
      {{/each}}
      {{#if totals}}
      <tr class="tot">
        <td class="lb">{{totals.label}}</td>
        <td>{{{formatCell totals.total.male}}}</td>
        <td>{{{formatCell totals.total.female}}}</td>
        <td class="tot-col">{{{formatCell totals.total.total}}}</td>
      </tr>
      {{/if}}
    </tbody>
  </table>
  {{/inline}}

  {{! ══ PAGE 1: Header + S0 + S1 ═══════════════════════════════════════ }}
  <div class="page">

    <div class="hdr">
      {{> letterhead}}
      <div class="hdr-bar">
        <div class="t1">{{t "common.survey_title"}}</div>
        <div class="t2">{{t "administration.subtitle"}}</div>
        <div style="font-size:6.5pt;color:#D9E1F2;margin-top:1.2mm;letter-spacing:0.3px;">{{#if officialBannerText}}{{officialBannerText}}{{else}}Formulaire officiel ONEFOP &middot; Document g&eacute;n&eacute;r&eacute; via la plateforme CAM-LEAP{{/if}}</div>
      </div>
    </div>

    <div class="conf">
      <strong>{{t "common.confidentiality"}}</strong>
    </div>

    <div class="sec">{{t "administration.sec0_title"}}</div>

    <table class="ftable">
      <tr>
        <td class="fc">S0Q01</td>
        <td>{{t "common.s0.name"}} {{respondentName}}</td>
      </tr>
      <tr>
        <td class="fc">S0Q02</td>
        <td>{{t "common.s0.function"}} {{respondentFunction}}</td>
      </tr>
      <tr>
        <td class="fc" style="vertical-align:top">S0Q03</td>
        <td>
          {{t "common.s0.contacts"}} {{t "common.s0.tel1"}} {{phoneBoxes respondentPhone1 9}} &nbsp; {{t "common.s0.tel2"}} {{phoneBoxes respondentPhone2 9}}<br />{{t "common.s0.email"}} {{respondentEmail}}
        </td>
      </tr>
    </table>

    <div class="sec">{{t "administration.sec1_title"}}</div>

    <table class="ftable">
      <tr>
        <td class="fc">S1Q01</td>
        <td>{{t "administration.s1q01"}} {{administrationName}}</td>
      </tr>
      <tr>
        <td class="fc">S1Q02</td>
        <td>{{t "administration.s1q02"}} {{sigle}}</td>
      </tr>
      <tr>
        <td class="fc">S1Q03</td>
        <td>{{t "administration.s1q03"}} &nbsp;
          <span class="radio-opt">{{#if (eq area 1)}}&#9745;{{else}}&#9744;{{/if}} {{t "administration.s1q03_1"}}</span> &nbsp;
          <span class="radio-opt">{{#if (eq area 2)}}&#9745;{{else}}&#9744;{{/if}} {{t "administration.s1q03_2"}}</span>
        </td>
      </tr>
      <tr>
        <td class="fc">S1Q04</td>
        <td>{{t "administration.s1q04_region"}} {{region}} &nbsp; {{t "administration.s1q04_dept"}} {{department}}<br />
          {{t "administration.s1q04_subdiv"}} {{subdivision}} &nbsp; {{t "administration.s1q04_locality"}} {{locality}}
        </td>
      </tr>
      <tr>
        <td class="fc">S1Q05</td>
        <td>{{t "administration.s1q05_tel1"}} {{phoneBoxes phone1 9}} &nbsp; {{t "administration.s1q05_tel2"}} {{phoneBoxes phone2 9}} &nbsp; {{t "administration.s1q05_bp"}} {{poBox}}
        </td>
      </tr>
      <tr>
        <td class="fc">S1Q06</td>
        <td>{{t "administration.s1q06"}} &nbsp;
          <span class="radio-opt">{{#if (eq businessSector 1)}}&#9745;{{else}}&#9744;{{/if}} {{t "administration.s1q06_1"}}</span> &nbsp;
          <span class="radio-opt">{{#if (eq businessSector 2)}}&#9745;{{else}}&#9744;{{/if}} {{t "administration.s1q06_2"}}</span> &nbsp;
          <span class="radio-opt">{{#if (eq businessSector 3)}}&#9745;{{else}}&#9744;{{/if}} {{t "administration.s1q06_3"}}</span>
        </td>
      </tr>
      <tr>
        <td class="fc">S1Q07</td>
        <td>{{t "administration.s1q07"}} {{branchActivity}}</td>
      </tr>
      <tr>
        <td class="fc">S1Q08</td>
        <td>{{t "administration.s1q08"}} {{mainMission}}</td>
      </tr>
      <tr>
        <td class="fc">S1Q09</td>
        <td>{{t "administration.s1q09"}} &nbsp;
          <span class="radio-opt">{{#if (eq hasProject 1)}}&#9745;{{else}}&#9744;{{/if}} {{t "administration.yes"}}</span>
          &nbsp;
          <span class="radio-opt">{{#if (eq hasProject 2)}}&#9745;{{else}}&#9744;{{/if}} {{t "administration.no"}}</span>
          &nbsp; &nbsp; {{t "administration.s1q10"}} {{projectCount}}
        </td>
      </tr>
      <tr>
        <td class="fc">S1Q11</td>
        <td>{{t "administration.s1q11"}} &nbsp;
          <span class="radio-opt">{{#if (eq hasSupervisedStructures 1)}}&#9745;{{else}}&#9744;{{/if}} {{t "administration.yes"}}</span> &nbsp;
          <span class="radio-opt">{{#if (eq hasSupervisedStructures 2)}}&#9745;{{else}}&#9744;{{/if}} {{t "administration.no"}}</span>
          &nbsp; &nbsp; {{t "administration.s1q12"}} {{supervisedStructureCount}}
        </td>
      </tr>
    </table>

    <div class="sec">{{t "administration.sec2_title"}}</div>

    <div class="qt">{{t "administration.s21q01" collectionPeriod=collectionPeriod}}</div>
    {{> cspAgeTable rows=jobApplicationsRows totals=jobApplicationsTotals}}

  </div>

  {{! ══ PAGE 2: S21Q02 recruitment + S21Q03 disability + S21Q04 vulnerable ═ }}
  <div class="page">

    <div class="qt">{{t "administration.s21q02" collectionPeriod=collectionPeriod}}</div>
    {{> cspAgeTable rows=recruitmentsPermanentRows totals=recruitmentsPermanentTotals}}

    <div class="qt">{{t "administration.s21q03" collectionPeriod=collectionPeriod}}</div>
    {{> sexTable rows=disabledRecruitmentsRows totals=disabledRecruitmentsTotals headerLabel=(t "administration.category")}}

    <div class="qt">{{t "administration.s21q04" collectionPeriod=collectionPeriod}}</div>
    {{> sexTable rows=vulnerableRecruitmentsRows totals=vulnerableRecruitmentsTotals headerLabel=(t "common.table.nature_of_vulnerability")}}

  </div>

  {{! ══ PAGE 3: S3 departures + S4 internship/skills ════════════════════ }}
  <div class="page">

    <div class="sec">{{t "common.s3.sec3_title"}}</div>

    <div class="qt">{{t "common.s3.s3q01" collectionPeriod=collectionPeriod}}</div>
    <table class="dt">
      <thead>
        <tr>
          <th rowspan="2" style="width:15%;background:#BFBFBF;color:#000">{{t "common.table.status"}}</th>
          <th colspan="3">{{t "common.table.dismissals"}}</th>
          <th colspan="3">{{t "common.table.resignations"}}</th>
          <th colspan="3">{{t "common.table.retirements"}}</th>
          <th colspan="3">{{t "common.table.other_departures"}}</th>
          <th colspan="3">{{t "common.table.ensemble"}}</th>
        </tr>
        <tr>
          <th class="g">M</th>
          <th class="g">F</th>
          <th class="g">T</th>
          <th class="g">M</th>
          <th class="g">F</th>
          <th class="g">T</th>
          <th class="g">M</th>
          <th class="g">F</th>
          <th class="g">T</th>
          <th class="g">M</th>
          <th class="g">F</th>
          <th class="g">T</th>
          <th class="g">M</th>
          <th class="g">F</th>
          <th class="g">T</th>
        </tr>
      </thead>
      <tbody>
        {{#each departuresRows}}
        <tr>
          <td class="lb">{{label}}</td>
          <td>{{{formatCell dismissals.male}}}</td>
          <td>{{{formatCell dismissals.female}}}</td>
          <td class="tot-col">{{{formatCell dismissals.total}}}</td>
          <td>{{{formatCell resignations.male}}}</td>
          <td>{{{formatCell resignations.female}}}</td>
          <td class="tot-col">{{{formatCell resignations.total}}}</td>
          <td>{{{formatCell retirements.male}}}</td>
          <td>{{{formatCell retirements.female}}}</td>
          <td class="tot-col">{{{formatCell retirements.total}}}</td>
          <td>{{{formatCell others.male}}}</td>
          <td>{{{formatCell others.female}}}</td>
          <td class="tot-col">{{{formatCell others.total}}}</td>
          <td>{{{formatCell ensemble.male}}}</td>
          <td>{{{formatCell ensemble.female}}}</td>
          <td class="tot-col">{{{formatCell ensemble.total}}}</td>
        </tr>
        {{/each}}
        <tr class="tot">
          <td class="lb">{{departuresTotals.label}}</td>
          <td>{{{formatCell departuresTotals.dismissals.male}}}</td>
          <td>{{{formatCell departuresTotals.dismissals.female}}}</td>
          <td class="tot-col">{{{formatCell departuresTotals.dismissals.total}}}</td>
          <td>{{{formatCell departuresTotals.resignations.male}}}</td>
          <td>{{{formatCell departuresTotals.resignations.female}}}</td>
          <td class="tot-col">{{{formatCell departuresTotals.resignations.total}}}</td>
          <td>{{{formatCell departuresTotals.retirements.male}}}</td>
          <td>{{{formatCell departuresTotals.retirements.female}}}</td>
          <td class="tot-col">{{{formatCell departuresTotals.retirements.total}}}</td>
          <td>{{{formatCell departuresTotals.others.male}}}</td>
          <td>{{{formatCell departuresTotals.others.female}}}</td>
          <td class="tot-col">{{{formatCell departuresTotals.others.total}}}</td>
          <td>{{{formatCell departuresTotals.ensemble.male}}}</td>
          <td>{{{formatCell departuresTotals.ensemble.female}}}</td>
          <td class="tot-col">{{{formatCell departuresTotals.ensemble.total}}}</td>
        </tr>
      </tbody>
    </table>

    <div class="qt">{{t "common.s3.s3q02"}}</div>
    <table class="dt">
      <thead>
        <tr>
          <th style="text-align:center;background:#BFBFBF;color:#000;width:62%">{{t "common.table.reasons"}}</th>
          <th class="g">M</th>
          <th class="g">F</th>
          <th class="g">Total</th>
        </tr>
