{{! ONEFOP — Questionnaire Projets & Programmes — Phase 1 v1 (derived from
    administration.hbs's CSS scaffold and cspAgeTable/permTempTable partials).
    Structural implementation only — bindings are complete (every PP_S1Q01-16
    field and Section 2/3/4 table below has a mapper output, see
    pdf-data-mapper.service.ts's mapProjectProgramData/buildS2S4ProjectProgram),
    but visual fidelity against the source PDF
    (Questionnaire_Projet_et_Programmes.pdf) has NOT been verified — review
    before production use, same deferred status Administration's template
    carried after its own Phase 1. }}
{{#with this}}
<!DOCTYPE html>
<html lang="{{lang}}">

<head>
  <meta charset="utf-8" />
  <title>ONEFOP Projets &amp; Programmes {{surveyYear}}</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0
    }

    body {
      font-family: "Arial Narrow", Arial, Helvetica, sans-serif;
      font-size: 9pt;
      color: #000;
      background: #fff;
      line-height: 1.3
    }

    .page {
      width: 210mm;
      min-height: 297mm;
      padding: 5mm 7mm;
      page-break-after: always;
      position: relative
    }

    .page:last-child {
      page-break-after: auto
    }

    .hdr {
      margin-bottom: 3mm;
      font-size: 8pt
    }

    .hdr-top {
      display: flex;
      align-items: flex-start;
      min-height: 24mm
    }

    .hdr-fr {
      width: 37%;
      padding: 1mm 2mm;
      text-align: center;
      font-size: 7.5pt;
      line-height: 1.45
    }

    .hdr-logo-c {
      width: 26%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      padding: 0 2mm
    }

    .hdr-logo-c img {
      max-width: 100%;
      max-height: 16mm;
      display: block;
      margin: 0 auto
    }

    .hdr-logo-c .ltag {
      font-size: 5.5pt;
      font-weight: bold;
      text-align: center;
      line-height: 1.2;
      text-transform: uppercase;
      margin-top: 1mm
    }

    .hdr-en {
      width: 37%;
      padding: 1mm 2mm;
      text-align: center;
      font-size: 7.5pt;
      line-height: 1.45
    }

    .hdr-fr .co,
    .hdr-en .co {
      font-weight: bold;
      font-size: 7.5pt
    }

    .sep {
      font-size: 6.5pt;
      color: #444
    }

    .hdr-bar {
      background: #1F3864;
      padding: 2.5mm 4mm;
      text-align: center
    }

    .hdr-bar .t1 {
      font-weight: bold;
      font-size: 9pt;
      color: #fff;
      text-transform: uppercase;
      line-height: 1.35
    }

    .hdr-bar .t2 {
      font-size: 7.5pt;
      color: #fff;
      font-style: italic;
      margin-top: 0.8mm
    }

    .conf {
      border: 1.5px solid #000;
      padding: 2mm 3mm;
      margin-bottom: 2.5mm;
      font-size: 7.5pt;
      line-height: 1.35
    }

    .sec {
      background: #5B9BD5;
      color: #fff;
      font-weight: bold;
      font-size: 9.5pt;
      padding: 2px 5px;
      margin: 2.5mm 0 1.5mm;
      text-transform: uppercase
    }

    .sec-s1 {
      background: #BDD7EE;
      color: #000;
      font-weight: bold;
      font-style: italic;
      font-size: 9.5pt;
      padding: 2px 5px;
      margin: 2.5mm 0 1.5mm
    }

    .subsec {
      background: #BDD7EE;
      color: #000;
      font-weight: bold;
      font-style: italic;
      font-size: 8.5pt;
      padding: 2px 5px;
      margin: 2mm 0 1.5mm
    }

    .qt {
      background: #FFF2CC;
      border: 1px solid #000;
      padding: 2px 4px;
      margin: 1.5mm 0 0;
      font-size: 7.5pt;
      line-height: 1.35
    }

    .ftable {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 1mm;
      font-size: 8pt
    }

    .ftable td {
      border: 1px solid #000;
      padding: 2px 3px;
      background: #fff;
      vertical-align: middle;
      font-size: 8pt;
      text-align: left
    }

    .ftable td.fc {
      font-weight: bold;
      width: 11mm;
      white-space: nowrap
    }

    .ph-box {
      display: inline-flex;
      gap: 0;
      vertical-align: middle
    }

    .ph-box .pd {
      display: inline-block;
      width: 5mm;
      height: 4.5mm;
      border: 1px solid #000;
      border-right: none;
      font-size: 7pt;
      text-align: center;
      line-height: 4.5mm;
      font-family: monospace;
      background: #fff
    }

    .ph-box .pd:last-child {
      border-right: 1px solid #000
    }

    .radio-opt {
      font-size: 8pt;
      white-space: nowrap
    }

    table.dt {
      width: 100%;
      border-collapse: collapse;
      margin: 0 0 1.5mm;
      font-size: 7pt
    }

    table.dt th {
      background: #BFBFBF;
      color: #000;
      text-align: center;
      padding: 2px 1px;
      border: 1px solid #000;
      font-size: 7.5pt;
      font-weight: bold;
      line-height: 1.15
    }

    table.dt th.g {
      background: #BFBFBF;
      color: #000
    }

    table.dt th.r {
      background: #D0CECE;
      color: #000
    }

    table.dt td {
      background: #fff;
      border: 1px solid #000;
      text-align: center;
      padding: 1px 1px;
      font-size: 7.5pt;
      height: 5mm;
      vertical-align: middle
    }

    table.dt td.lb {
      background: #DEEAF6;
      text-align: left;
      font-size: 7.5pt;
      padding-left: 3px;
      height: 5mm
    }

    table.dt td.tot-col {
      background: #DEEAF6
    }

    table.dt tr.tot td {
      background: #DEEAF6;
      font-weight: bold
    }

    table.dt tr.tot td.lb {
      background: #DEEAF6;
      font-weight: bold
    }

    @media print {
      body {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact
      }
    }
  </style>
</head>

<body>

  {{! ══ PARTIALS (copied verbatim from administration.hbs) ═════════════ }}

  {{#*inline "cspAgeTable"}}
  <table class="dt">
    <thead>
      <tr>
        <th style="width:16%;background:#BFBFBF;color:#000">{{t "common.table.sex"}}</th>
        <th colspan="4">{{t "common.table.male"}}</th>
        <th colspan="4">{{t "common.table.female"}}</th>
        <th colspan="4">{{t "common.table.total"}}</th>
      </tr>
      <tr>
        <th class="g">{{t "common.table.age_group"}}</th>
        <th class="g">{{t "common.table.age_15_24"}}</th>
        <th class="g">{{t "common.table.age_25_34"}}</th>
        <th class="g">{{t "common.table.age_35_plus"}}</th>
        <th class="g">{{t "common.table.total"}}</th>
        <th class="g">{{t "common.table.age_15_24"}}</th>
        <th class="g">{{t "common.table.age_25_34"}}</th>
        <th class="g">{{t "common.table.age_35_plus"}}</th>
        <th class="g">{{t "common.table.total"}}</th>
        <th class="g">{{t "common.table.age_15_24"}}</th>
        <th class="g">{{t "common.table.age_25_34"}}</th>
        <th class="g">{{t "common.table.age_35_plus"}}</th>
        <th class="g">{{t "common.table.total"}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each rows}}
      <tr>
        <td class="lb">{{label}}</td>
        <td>{{{formatCell male.age15_24}}}</td>
        <td>{{{formatCell male.age25_34}}}</td>
        <td>{{{formatCell male.age35plus}}}</td>
        <td class="tot-col">{{{formatCell male.total}}}</td>
        <td>{{{formatCell female.age15_24}}}</td>
        <td>{{{formatCell female.age25_34}}}</td>
        <td>{{{formatCell female.age35plus}}}</td>
        <td class="tot-col">{{{formatCell female.total}}}</td>
        <td>{{{formatCell this.total.age15_24}}}</td>
        <td>{{{formatCell this.total.age25_34}}}</td>
        <td>{{{formatCell this.total.age35plus}}}</td>
        <td class="tot-col">{{{formatCell this.total.total}}}</td>
      </tr>
      {{/each}}
      {{#if totals}}
      <tr class="tot">
        <td class="lb">{{totals.label}}</td>
        <td>{{{formatCell totals.male.age15_24}}}</td>
        <td>{{{formatCell totals.male.age25_34}}}</td>
        <td>{{{formatCell totals.male.age35plus}}}</td>
        <td class="tot-col">{{{formatCell totals.male.total}}}</td>
        <td>{{{formatCell totals.female.age15_24}}}</td>
        <td>{{{formatCell totals.female.age25_34}}}</td>
        <td>{{{formatCell totals.female.age35plus}}}</td>
        <td class="tot-col">{{{formatCell totals.female.total}}}</td>
        <td>{{{formatCell totals.total.age15_24}}}</td>
        <td>{{{formatCell totals.total.age25_34}}}</td>
        <td>{{{formatCell totals.total.age35plus}}}</td>
        <td class="tot-col">{{{formatCell totals.total.total}}}</td>
      </tr>
      {{/if}}
    </tbody>
  </table>
  {{/inline}}

  {{#*inline "permTempTable"}}
  <table class="dt">
    <thead>
      <tr>
        <th rowspan="2" style="width:28%;background:#D0CECE;color:#000">{{#if headerLabel}}{{{headerLabel}}}{{else}}{{t "common.table.csp"}}{{/if}}</th>
        <th class="r" colspan="3">{{t "common.table.permanent"}}</th>
        <th class="r" colspan="3">{{t "common.table.temporary"}}</th>
        <th class="r">{{t "common.table.total"}}</th>
      </tr>
      <tr>
        <th class="r">{{t "common.table.m"}}</th>
        <th class="r">{{t "common.table.f"}}</th>
        <th class="r">{{t "common.table.t"}}</th>
        <th class="r">{{t "common.table.m"}}</th>
        <th class="r">{{t "common.table.f"}}</th>
        <th class="r">{{t "common.table.t"}}</th>
        <th class="r">&nbsp;</th>
      </tr>
    </thead>
    <tbody>
      {{#each rows}}
      <tr>
        <td class="lb">{{label}}</td>
        <td>{{{formatCell permanent.male}}}</td>
        <td>{{{formatCell permanent.female}}}</td>
        <td class="tot-col">{{{formatCell permanent.total}}}</td>
        <td>{{{formatCell temporary.male}}}</td>
        <td>{{{formatCell temporary.female}}}</td>
        <td class="tot-col">{{{formatCell temporary.total}}}</td>
        <td class="tot-col">{{{formatCell this.total.total}}}</td>
      </tr>
      {{/each}}
      {{#if totals}}
      <tr class="tot">
        <td class="lb">{{totals.label}}</td>
        <td>{{{formatCell totals.permanent.male}}}</td>
        <td>{{{formatCell totals.permanent.female}}}</td>
        <td class="tot-col">{{{formatCell totals.permanent.total}}}</td>
        <td>{{{formatCell totals.temporary.male}}}</td>
        <td>{{{formatCell totals.temporary.female}}}</td>
        <td class="tot-col">{{{formatCell totals.temporary.total}}}</td>
        <td class="tot-col">{{{formatCell totals.total.total}}}</td>
      </tr>
      {{/if}}
    </tbody>
  </table>
  {{/inline}}

  {{! ══ PAGE 1: Header + S0 + S1 ═══════════════════════════════════════ }}
  <div class="page">

    <div class="hdr">
      {{> letterhead}}
      <div class="hdr-bar">
        <div class="t1">{{t "common.survey_title"}}</div>
        <div class="t2">{{t "projectProgram.subtitle"}}</div>
        <div style="font-size:6.5pt;color:#D9E1F2;margin-top:1.2mm;letter-spacing:0.3px;">{{#if officialBannerText}}{{officialBannerText}}{{else}}Formulaire officiel ONEFOP &middot; Document g&eacute;n&eacute;r&eacute; via la plateforme CAM-LEAP{{/if}}</div>
      </div>
    </div>

    <div class="conf">
      <strong>{{t "common.confidentiality"}}</strong>
    </div>

    <div class="sec">{{t "projectProgram.sec0_title"}}</div>

    <table class="ftable">
      <tr>
        <td class="fc">S0Q01</td>
        <td>{{t "common.s0.name"}} {{respondentName}}</td>
      </tr>
      <tr>
        <td class="fc">S0Q02</td>
        <td>{{t "common.s0.function"}} {{respondentFunction}}</td>
      </tr>
      <tr>
        <td class="fc" style="vertical-align:top">S0Q03</td>
        <td>
          {{t "common.s0.contacts"}}
          T&#233;l 1 : {{respondentPhone1}} &nbsp; T&#233;l 2 : {{respondentPhone2}}<br />
          E-mail : {{respondentEmail}}
        </td>
      </tr>
    </table>

    <div class="sec">{{t "projectProgram.sec1_title"}}</div>

    <table class="ftable">
      <tr>
        <td class="fc">S1Q01</td>
        <td>{{t "projectProgram.s1q01"}} &nbsp;
          <span class="radio-opt">{{#if (eq nature 1)}}&#9745;{{else}}&#9744;{{/if}} {{t "projectProgram.s1q01_1"}}</span> &nbsp;
          <span class="radio-opt">{{#if (eq nature 2)}}&#9745;{{else}}&#9744;{{/if}} {{t "projectProgram.s1q01_2"}}</span> &nbsp;
          <span class="radio-opt">{{#if (eq nature 3)}}&#9745;{{else}}&#9744;{{/if}} {{t "projectProgram.s1q01_3"}}</span> &nbsp;
          <span class="radio-opt">{{#if (eq nature 4)}}&#9745;{{else}}&#9744;{{/if}} {{t "projectProgram.s1q01_4"}}</span>
        </td>
      </tr>
      <tr>
        <td class="fc">S1Q02</td>
        <td>{{t "projectProgram.s1q02"}} {{projectProgramName}}</td>
      </tr>
      <tr>
        <td class="fc">S1Q03</td>
        <td>{{t "projectProgram.s1q03"}} {{sigle}}</td>
      </tr>
      <tr>
        <td class="fc">S1Q04</td>
        <td>{{t "projectProgram.s1q04"}} {{personInCharge}}</td>
      </tr>
      <tr>
        <td class="fc">S1Q05</td>
        <td>{{t "projectProgram.s1q05"}} &nbsp;
          <span class="radio-opt">{{#if (eq area 1)}}&#9745;{{else}}&#9744;{{/if}} {{t "projectProgram.s1q05_1"}}</span> &nbsp;
          <span class="radio-opt">{{#if (eq area 2)}}&#9745;{{else}}&#9744;{{/if}} {{t "projectProgram.s1q05_2"}}</span>
        </td>
      </tr>
      <tr>
        <td class="fc">S1Q06</td>
        <td>{{t "projectProgram.s1q06_region"}} {{region}} &nbsp; {{t "projectProgram.s1q06_dept"}} {{department}}<br />
          {{t "projectProgram.s1q06_subdiv"}} {{subdivision}} &nbsp; {{t "projectProgram.s1q06_locality"}} {{locality}}
        </td>
      </tr>
      <tr>
        <td class="fc">S1Q07</td>
        <td>{{t "projectProgram.s1q07_tel1"}} {{phone1}} &nbsp; {{t "projectProgram.s1q07_tel2"}} {{phone2}} &nbsp; {{t "projectProgram.s1q07_bp"}} {{poBox}}
        </td>
      </tr>
      <tr>
        <td class="fc">S1Q08</td>
        <td>{{t "projectProgram.s1q08"}} &nbsp;
          <span class="radio-opt">{{#if (eq businessSector 1)}}&#9745;{{else}}&#9744;{{/if}} {{t "projectProgram.s1q08_1"}}</span> &nbsp;
          <span class="radio-opt">{{#if (eq businessSector 2)}}&#9745;{{else}}&#9744;{{/if}} {{t "projectProgram.s1q08_2"}}</span> &nbsp;
          <span class="radio-opt">{{#if (eq businessSector 3)}}&#9745;{{else}}&#9744;{{/if}} {{t "projectProgram.s1q08_3"}}</span>
        </td>
      </tr>
      <tr>
        <td class="fc">S1Q09</td>
        <td>{{t "projectProgram.s1q09"}} {{branchActivity}}</td>
      </tr>
      <tr>
        <td class="fc">S1Q10</td>
        <td>{{t "projectProgram.s1q10"}} {{mainMission}}</td>
      </tr>
      <tr>
        <td class="fc">S1Q11</td>
        <td>{{t "common.s1.head_office"}} {{headOffice}}</td>
      </tr>
      <tr>
        <td class="fc">S1Q12</td>
        <td>{{t "projectProgram.s1q12"}} {{supervisingMinistry}}</td>
      </tr>
      <tr>
        <td class="fc">S1Q13</td>
        <td>{{t "projectProgram.s1q13"}} &nbsp;
          <span class="radio-opt">{{#if (eq status 1)}}&#9745;{{else}}&#9744;{{/if}} {{t "projectProgram.s1q13_1"}}</span> &nbsp;
          <span class="radio-opt">{{#if (eq status 2)}}&#9745;{{else}}&#9744;{{/if}} {{t "projectProgram.s1q13_2"}}</span> &nbsp;
          <span class="radio-opt">{{#if (eq status 3)}}&#9745;{{else}}&#9744;{{/if}} {{t "projectProgram.s1q13_3"}}</span>
        </td>
      </tr>
      {{#if (eq status 1)}}
      <tr>
        <td class="fc">S1Q14</td>
        <td>{{t "projectProgram.s1q14"}} &nbsp;
          <span class="radio-opt">{{#if (eq stopReason 1)}}&#9745;{{else}}&#9744;{{/if}} {{t "projectProgram.s1q14_1"}}</span> &nbsp;
          <span class="radio-opt">{{#if (eq stopReason 2)}}&#9745;{{else}}&#9744;{{/if}} {{t "projectProgram.s1q14_2"}}</span> &nbsp;
          <span class="radio-opt">{{#if (eq stopReason 3)}}&#9745;{{else}}&#9744;{{/if}} {{t "projectProgram.s1q14_3"}}</span> &nbsp;
          <span class="radio-opt">{{#if (eq stopReason 4)}}&#9745;{{else}}&#9744;{{/if}} {{t "projectProgram.s1q14_4"}}</span>
        </td>
      </tr>
      {{/if}}
      <tr>
        <td class="fc">S1Q15</td>
        <td>{{t "common.s1.permanent_workers"}} {{permanentWorkers}}</td>
      </tr>
      <tr>
        <td class="fc">S1Q16</td>
        <td>{{t "common.s1.vacancies"}} {{vacancies}}</td>
      </tr>
    </table>

  </div>

  {{! ══ PAGE 2: Section 2 activities table ══════════════════════════════ }}
  <div class="page">

    <div class="sec">{{t "projectProgram.sec2_title"}}</div>

    <table class="dt">
      <thead>
        <tr>
          <th style="width:6%">{{t "projectProgram.activities.num"}}</th>
          <th style="width:24%">{{t "projectProgram.activities.description"}}</th>
          <th style="width:16%">{{t "projectProgram.activities.target"}}</th>
          <th style="width:18%">{{t "projectProgram.activities.support"}}</th>
          <th style="width:12%">{{t "projectProgram.activities.scope"}}</th>
          <th style="width:12%">{{t "projectProgram.activities.start_date"}}</th>
          <th style="width:12%">{{t "projectProgram.activities.duration"}}</th>
        </tr>
      </thead>
      <tbody>
        {{#each activitiesRows}}
        <tr>
          <td>{{index}}</td>
          <td class="lb">{{description}}</td>
          <td class="lb">{{targetPopulation}}</td>
          <td class="lb">{{supportType}}</td>
          <td class="lb">{{scope}}</td>
          <td>{{startDate}}</td>
          <td>{{duration}}</td>
        </tr>
        {{/each}}
        {{#unless activitiesRows}}
        <tr>
          <td colspan="7" class="lb">{{#if (eq @root.lang "en")}}No activity reported{{else}}Aucune activité déclarée{{/if}}</td>
        </tr>
        {{/unless}}
      </tbody>
    </table>

  </div>

  {{! ══ PAGE 3: Section 3 outcomes + Section 4 recruitment tables ═══════ }}
  <div class="page">

    <div class="sec">{{t "projectProgram.sec3_title"}}</div>

    <table class="dt">
      <thead>
        <tr>
          <th style="width:40%">{{t "projectProgram.outcomes.kpi"}}</th>
          <th>{{t "projectProgram.outcomes.current"}}</th>
          <th>{{t "projectProgram.outcomes.outlook_dec"}}</th>
          <th>{{t "projectProgram.outcomes.outlook_june"}}</th>
        </tr>
      </thead>
      <tbody>
        {{#each outcomesRows}}
        <tr>
          <td class="lb">{{label}}</td>
          <td>{{{formatCell current}}}</td>
          <td>{{{formatCell outlookDec}}}</td>
          <td>{{{formatCell outlookJune}}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    <div class="sec">{{t "projectProgram.sec4_title"}}</div>

    <div class="qt">{{t "projectProgram.s4q01" collectionPeriod=collectionPeriod}}</div>
    {{> cspAgeTable rows=countedPermanentRows totals=countedPermanentTotals}}

    <div class="qt">{{t "projectProgram.s4q02" collectionPeriod=collectionPeriod}}</div>
    {{> cspAgeTable rows=countedTemporaryRows totals=countedTemporaryTotals}}

  </div>

  {{! ══ PAGE 4: Section 4 continued ══════════════════════════════════════ }}
  <div class="page">

    <div class="qt">{{t "projectProgram.s4q03" collectionPeriod=collectionPeriod}}</div>
    {{> cspAgeTable rows=recruitedPermanentRows totals=recruitedPermanentTotals}}

    <div class="qt">{{t "projectProgram.s4q04" collectionPeriod=collectionPeriod}}</div>
    {{> cspAgeTable rows=recruitedTemporaryRows totals=recruitedTemporaryTotals}}

    <div class="qt">{{t "projectProgram.s4q05" collectionPeriod=collectionPeriod}}</div>
    {{> permTempTable rows=disabledRecruitmentsRows totals=disabledRecruitmentsTotals}}

    <div class="qt">{{t "projectProgram.s4q06" collectionPeriod=collectionPeriod}}</div>
    {{> permTempTable rows=vulnerableRecruitmentsRows totals=vulnerableRecruitmentsTotals}}

  </div>

</html>
{{/with}}
